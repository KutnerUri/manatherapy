---
import type { HTMLAttributes } from "astro/types";
import type { AccentKey } from "../data/paletteSnapshots";

interface Props extends Omit<HTMLAttributes<"span">, "data-accent"> {
  value?: string | number;
  accent?: AccentKey;
}

const { value = "1", accent, class: className, ...rest }: Props = Astro.props;
---

<span {...rest} data-accent={accent} class:list={["mana-badge", className]}>{value}</span>

<style>
  .mana-badge {
    --color-mana-surface: var(--color-accent-full);

    width: round(1.38em, 2px);
    height: round(1.38em, 2px);
    line-height: round(1.38em, 2px);
    font-family: math;
    border-radius: 999px;
    background: var(--color-mana-surface);
    color: var(--ink);
    border: 1px solid rgba(0, 0, 0, 0.13);
    display: grid;
    flex: none;
    place-items: center;
    font-weight: 700;
    box-shadow:
      0 8px 18px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
</style>
