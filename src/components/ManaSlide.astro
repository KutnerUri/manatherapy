---
import Slide from "./Slide.astro";

type Props = {
  slide: number;
  colorClass: "blue" | "green" | "red" | "yellow" | "black";
  logo: ImageMetadata;
  logoAlt: string;
  sub: string;
  subtitle: string;
  class?: string;
};

const {
  slide,
  colorClass,
  logo,
  logoAlt = "",
  sub = "",
  subtitle = "",
  class: className,
  ...rest
} = Astro.props as Props;

---

<Slide
  {...rest}
  class:list={["slide-color", colorClass, `accent-${colorClass}`, className]}
  slide={slide}
>
  <div class="color-logo">
    <img src={logo.src} alt={logoAlt} />
    <p class="color-sub">{sub}</p>
    <p class="color-subtitle">{subtitle}</p>
  </div>
  <slot />
</Slide>

<style>
  .slide-color {
    background:
      linear-gradient(
        to bottom,
        var(--color-accent-shadow) 0%,
        transparent 15%,
        transparent 85%,
        var(--color-accent-shadow) 100%
      ),
      radial-gradient(
        circle at 85% 85%,
        var(--color-accent-shadow),
        transparent 60%
      ),
      linear-gradient(
        160deg,
        var(--color-accent-bg) 0%,
        var(--color-accent-bg-strong) 55%,
        var(--color-accent-border) 100%
      );
    color: var(--color-accent-text, var(--color-text));
  }

  .slide-color.black {
    background:
      linear-gradient(
        to bottom,
        var(--color-metal-mist) 0%,
        transparent 15%
      ),
      radial-gradient(
        circle at 50% 50%,
        var(--color-metal-core) 0%,
        var(--color-metal-core-strong) 40%,
        transparent 100%
      ),
      radial-gradient(
        circle at 50% 50%,
        var(--color-metal-aura) 0%,
        var(--color-metal-aura-soft) 55%,
        transparent 75%
      ),
      linear-gradient(
        160deg,
        var(--color-accent-bg) 0%,
        var(--color-accent-bg-strong) 55%,
        var(--color-metal-core) 100%
      );
  }

  .color-sub {
    font-size: 100px;
    margin: 0;
    margin-top: -14vmin;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .color-subtitle {
    font-size: 38px;
    margin: 0;
    opacity: 0.62;
  }

  .color-logo {
    text-align: center;
  }

  .color-logo img {
    width: min(62vh, 100vw);
    height: auto;
  }
</style>
