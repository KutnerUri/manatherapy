---
import Slide from "./Slide.astro";

type Props = {
  slide: number;
  colorClass: "blue" | "green" | "red" | "yellow" | "black";
  logo: ImageMetadata;
  logoAlt: string;
  sub: string;
  subtitle: string;
  class?: string;
};

const {
  slide,
  colorClass,
  logo,
  logoAlt = "",
  sub = "",
  subtitle = "",
  class: className,
  ...rest
} = Astro.props as Props;

---

<Slide
  {...rest}
  class:list={["slide-color", colorClass, `accent-${colorClass}`, className]}
  slide={slide}
>
  <div class="color-logo">
    <img src={logo.src} alt={logoAlt} />
    <p class="color-sub">{sub}</p>
    <p class="color-subtitle">{subtitle}</p>
  </div>
  <slot />
</Slide>

<style>
  .slide-color {
    background:
      linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.22) 0%,
        transparent 20%,
        transparent 80%,
        rgba(0, 0, 0, 0.08) 100%
      ),
      radial-gradient(
        circle at 85% 85%,
        var(--full),
        transparent 60%
      ),
      linear-gradient(
        160deg,
        var(--wallpaper) 0%,
        var(--surface) 55%,
        var(--highlight) 100%
      );
    color: var(--ink);
  }

  .slide-color.black {
    background:
      radial-gradient(
        circle at 50% 45%,
        var(--full) 0%,
        transparent 60%
      ),
      radial-gradient(
        circle at 20% 10%,
        rgba(255, 255, 255, 0.26) 0%,
        transparent 60%
      ),
      linear-gradient(
        160deg,
        var(--surface) 0%,
        var(--highlight) 58%,
        var(--wallpaper) 100%
      );
  }

  .color-sub {
    font-size: 100px;
    margin: 0;
    margin-top: -14vmin;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .color-subtitle {
    font-size: 38px;
    margin: 0;
    opacity: 0.62;
  }

  .color-logo {
    text-align: center;
  }

  .color-logo img {
    width: min(62vh, 100vw);
    height: auto;
  }
</style>
