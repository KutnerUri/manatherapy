---
import Slide from "./Slide.astro";

type Props = {
  slide: number;
  colorClass: "blue" | "green" | "red" | "yellow" | "black";
  logo: ImageMetadata;
  logoAlt: string;
  sub: string;
  subtitle: string;
  class?: string;
};

const {
  slide,
  colorClass,
  logo,
  logoAlt = "",
  sub = "",
  subtitle = "",
  class: className,
  ...rest
} = Astro.props as Props;

---

<Slide
  {...rest}
  class:list={["slide-color", colorClass, `accent-${colorClass}`, className]}
  slide={slide}
>
  <div class="color-logo">
    <img src={logo.src} alt={logoAlt} />
    <p class="color-sub">{sub}</p>
    <p class="color-subtitle">{subtitle}</p>
  </div>
  <slot />
</Slide>

<style>
  .slide-color {
    background: var(--color-accent-wallpaper);
    color: var(--ink);
  }

  .color-sub {
    font-size: 100px;
    margin: 0;
    margin-top: -14vmin;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .color-subtitle {
    font-size: 38px;
    margin: 0;
    opacity: 0.62;
  }

  .color-logo {
    text-align: center;
  }

  .color-logo img {
    width: min(62vh, 100vw);
    height: auto;
  }
</style>
