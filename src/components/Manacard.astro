---
import type { HTMLAttributes } from "astro/types";
import type { AccentKey } from "../data/paletteSnapshots";
import ManaBadge from "./ManaBadge.astro";

interface Props extends Omit<HTMLAttributes<"article">, "data-accent"> {
  accent?: AccentKey;
  title?: string;
  mana?: string | number;
  showMana?: boolean;
  imageSrc: string;
  imageAlt?: string;
  lines?: string[];
}

const {
  accent,
  title = "Driving",
  mana = "1",
  showMana = true,
  imageSrc,
  imageAlt = "Driving card artwork",
  lines = ["control the vehicle", "obey road signs", "blend in traffic"],
  class: className,
  ...rest
}: Props = Astro.props;
---

<article {...rest} data-accent={accent} class:list={["manacard-template", className]}>
  <div class="manacard-header">
    <strong class="manacard-title">{title}</strong>
    {showMana && <ManaBadge value={mana} accent={accent} />}
  </div>

  <div class="manacard-image-slot" aria-label="Card artwork">
    <img class="manacard-image" src={imageSrc} alt={imageAlt} />
  </div>

  <div class="manacard-content">
    <div class="manacard-lines" aria-label="Card text">
      {lines.map((line) => <p>{line}</p>)}
    </div>
  </div>
</article>

<style>
  .manacard-template {
    --color-card-surface: var(--color-accent-surface);
    --color-card-highlight: var(--color-accent-highlight);
    --color-card-content-surface: var(--color-content-surface);

    font-size: 0.86em;
    width: 13em;
    min-width: 0;
    flex: none;
    margin: 0;
    min-height: 0;
    height: auto;
    aspect-ratio: 13 / 21;
    position: relative;
    border-radius: 1em;
    background: var(--color-card-surface);
    border: 1px solid rgba(0, 0, 0, 0.14);
    box-shadow:
      0 0.58em 1.45em rgba(0, 0, 0, 0.07),
      inset 0 0.07em 0 rgba(255, 255, 255, 0.72);
    overflow: hidden;
    display: grid;
    grid-template-rows: 9fr 38fr 53fr;
    align-content: stretch;
    gap: 0.52em;
    padding: 0.64em;
  }

  .manacard-header,
  .manacard-image-slot,
  .manacard-content {
    min-height: 0;
  }

  .manacard-header {
    border-radius: 0.62em;
    background: var(--color-card-highlight);
    color: var(--ink);
    border: 0;
    padding: 0 0.38em;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 0.7em;
  }

  .manacard-title {
    font-size: 1.16em;
    letter-spacing: 0.01em;
  }

  .manacard-image-slot {
    border-radius: 0.72em;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.15);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.18)),
      repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.03) 0 8px, rgba(0, 0, 0, 0.06) 8px 16px);
  }

  .manacard-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .manacard-content {
    border-radius: 0.72em;
    background: transparent;
    color: var(--ink);
    border: 0;
    padding: 0;
    overflow: auto;
    align-content: start;
    display: grid;
    gap: 0.4em;
  }

  .manacard-lines {
    display: grid;
    gap: 0.35em;
  }

  .manacard-lines p {
    margin: 0;
    font-size: 1em;
    line-height: 1.25;
    opacity: 0.9;
  }
</style>
