---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...rest }: Props = Astro.props;
const baseUrl = new URL(import.meta.env.BASE_URL, Astro.url);
---

<div class:list={["pentagon", className]} {...rest}>
  <a
    class="mana-circle water"
    href={new URL("purity/", baseUrl).pathname}
    aria-label="תודעה"
  >
    <span class="mana-label">תודעה</span>
  </a>
  <div
    class="mana-circle plant is-disabled"
    role="img"
    aria-label="קבוצה"
  >
    <span class="mana-label">קבוצה</span>
  </div>
  <div
    class="mana-circle fire is-disabled"
    role="img"
    aria-label="חיוּת"
  >
    <span class="mana-label">חיוּת</span>
  </div>
  <a
    class="mana-circle earth"
    href={new URL("fairness/", baseUrl).pathname}
    aria-label="סימטריה"
  >
    <span class="mana-label">סימטריה</span>
  </a>
  <a
    class="mana-circle metal"
    href={new URL("bond/", baseUrl).pathname}
    aria-label="אגד"
  >
    <span class="mana-label">אגד</span>
  </a>
</div>

<style>
  .pentagon {
    position: relative;
    width: min(76vw, 560px);
    aspect-ratio: 1 / 1;
    margin: 0;
    --orbit: 23vmin;
    isolation: isolate;
  }

  .pentagon::before {
    content: "";
    position: absolute;
    inset: calc(var(--orbit) * -0.72);
    border-radius: 999px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.42;
    filter: blur(26px) saturate(0.88);
    background:
      radial-gradient(
        circle at calc(50% + 0px) calc(50% - var(--orbit)),
        color-mix(in srgb, var(--token-water-full) 34%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at calc(50% + (var(--orbit) * 0.951))
          calc(50% + (var(--orbit) * -0.309)),
        color-mix(in srgb, var(--token-plant-full) 34%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at calc(50% + (var(--orbit) * 0.588))
          calc(50% + (var(--orbit) * 0.809)),
        color-mix(in srgb, var(--token-fire-full) 34%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at calc(50% + (var(--orbit) * -0.588))
          calc(50% + (var(--orbit) * 0.809)),
        color-mix(in srgb, var(--token-earth-full) 34%, transparent),
        transparent 28%
      ),
      radial-gradient(
        circle at calc(50% + (var(--orbit) * -0.951))
          calc(50% + (var(--orbit) * -0.309)),
        color-mix(in srgb, var(--token-metal-full) 34%, transparent),
        transparent 28%
      );
  }

  .mana-circle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 23vmin;
    height: 23vmin;
    border-radius: 999px;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    place-items: center;
    font-size: clamp(1.05rem, 2.6vw, 1.6rem);
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--mana-text, var(--ink));
    --shine-opacity: 0.23;
    background-image:
      radial-gradient(
        circle at 30% 20%,
        rgba(255, 255, 255, var(--shine-opacity)),
        transparent 60%
      ),
      var(--mana-image),
      radial-gradient(circle at 30% 20%, var(--mana-base), var(--mana-deep) 70%);
    background-size:
      100% 100%,
      175% 175%,
      100% 100%;
    background-position: center;
    background-repeat: no-repeat;
    box-shadow:
      0 18px 35px rgba(0, 0, 0, var(--shadow-alpha, 0.16)),
      0 0 24px var(--mana-glow, var(--fx-shadow-soft)),
      inset 0 0 0 1px var(--fx-highlight);
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 0.5s ease,
      opacity 0.5s ease,
      box-shadow 0.2s ease;
    transition-delay: var(--delay, 0s);

    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;

    user-select: none;
    z-index: 1;
  }

  .mana-label {
    z-index: 2;
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    text-shadow:
      0 0px 2px var(--fx-shadow-sharp),
      0 2px 4px var(--fx-light-glow);
  }

  .mana-circle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  :global(.slide.is-active) .mana-circle {
    opacity: 1;
    transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(1);
  }

  .mana-circle:active {
    transform: translate(-50%, -50%) translate(var(--x), var(--y)) scale(0.95);
    box-shadow: 0 12px 25px var(--fx-shadow-subtle);
  }

  .mana-circle.is-disabled {
    cursor: default;
    pointer-events: none;
  }

  .mana-circle.fire {
    --x: calc(var(--orbit) * 0.588);
    --y: calc(var(--orbit) * 0.809);
    --delay: 0.2s;
    --mana-image: url("../assets/logos/fire.webp");
    --mana-base: var(--token-fire-highlight);
    --mana-deep: var(--token-fire-full);
    --mana-glow: var(--token-fire-full);
    --mana-text: var(--ink);
  }

  .mana-circle.plant {
    --x: calc(var(--orbit) * 0.951);
    --y: calc(var(--orbit) * -0.309);
    --delay: 0.1s;
    --mana-image: url("../assets/logos/plant.webp");
    --mana-base: var(--token-plant-highlight);
    --mana-deep: var(--token-plant-full);
    --mana-glow: var(--token-plant-full);
    --mana-text: var(--ink);
  }

  .mana-circle.earth {
    --x: calc(var(--orbit) * -0.588);
    --y: calc(var(--orbit) * 0.809);
    --delay: 0.3s;
    --mana-image: url("../assets/logos/sun.webp");
    --shadow-alpha: 0.12;
    --mana-base: var(--token-earth-highlight);
    --mana-deep: var(--token-earth-full);
    --mana-glow: var(--token-earth-full);
    --mana-text: var(--ink);
  }

  .mana-circle.water {
    --x: 0px;
    --y: calc(var(--orbit) * -1);
    --delay: 0s;
    --mana-image: url("../assets/logos/water.webp");
    --mana-base: var(--token-water-highlight);
    --mana-deep: var(--token-water-full);
    --mana-glow: var(--token-water-full);
    --mana-text: var(--ink);
  }

  .mana-circle.metal {
    --x: calc(var(--orbit) * -0.951);
    --y: calc(var(--orbit) * -0.309);
    --delay: 0.4s;
    --mana-image: url("../assets/logos/metal.webp");
    --shadow-alpha: 0.12;
    --mana-base: var(--token-metal-highlight);
    --mana-deep: var(--token-metal-full);
    --mana-glow: var(--token-metal-full);
    --mana-text: var(--ink);
  }

  @media (max-width: 720px) {
    .pentagon::before {
      display: none;
    }

    .pentagon {
      width: 100%;
      aspect-ratio: auto;
      display: grid;
      gap: 4vh;
      justify-items: center;
    }

    .mana-circle {
      position: relative;
      left: auto;
      top: auto;
      width: 23vh;
      height: 9vh;
      background-size:
        100% 100%,
        210% auto,
        100% 100%;
    }

    :global(.slide.is-active) .mana-circle {
      transform: scale(1);
    }

    .mana-circle:active {
      transform: scale(0.95);
    }
  }
</style>
