---
type Props = {
  class?: string;
};

const { class: className, ...rest } = Astro.props as Props;
const classes = [className].filter(Boolean);
---

<div class:list={["scroll-hint", ...classes]} aria-hidden="true" {...rest}>
  המשך
  <br />
  <span class="scroll-arrow">↓</span>
</div>

<style>
  .scroll-hint {
    position: absolute;
    bottom: 5vh;
    left: 50%;
    transform: translateX(-50%);
    color: inherit;
    user-select: none;
    opacity: 0;
    animation: hint-fade 2300ms ease-in-out alternate infinite;
    animation-delay: 3800ms;
    text-align: center;
    font-size: 1.5rem;
  }

  .scroll-arrow {
    font-size: 1.62em;
    line-height: 1;
  }

  @keyframes hint-fade {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      animation: none;
      opacity: 0.7;
    }
  }
</style>
