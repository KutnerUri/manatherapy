---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"section"> {
  slide?: number;
}

const { class: className, slide, ...rest }: Props = Astro.props;
---

<section class:list={["slide", className]} data-slide={slide} {...rest}>
  <slot />
</section>

<style>
  .slide {
    position: relative;
    height: 100%;

    display: grid;
    place-items: center;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    background:
      radial-gradient(
        circle at 20% 20%,
        var(--fx-shadow-ghost),
        transparent 60%
      ),
      radial-gradient(
        circle at 80% 70%,
        var(--fx-shadow-soft),
        transparent 60%
      ),
      var(--wallpaper);
  }

  .text-slide {
    padding: 8vh 8vw;
  }

  @media (max-width: 720px) {
    .text-slide {
      padding: 10vh 10vw;
    }
  }
</style>
