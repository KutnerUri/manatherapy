---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  color?: "white" | "blue" | "red" | "black";
  quote?: string;
  title?: string;
  costs?: Array<
    | string
    | {
        color: string;
        value?: string;
        label?: string;
      }
  >;
  image?: ImageMetadata;
  imageAlt?: string;
  imageClass?: string;
  draggable?: boolean;
}

const {
  class: className,
  color,
  quote,
  title = "",
  costs = [],
  image,
  imageAlt = "",
  imageClass = "main",
  draggable,
  ...rest
}: Props = Astro.props;

const imageSrc = image?.src;
const accentClass = color && color !== "result" ? `accent-${color}` : undefined;
const costItems = costs.map((cost) => {
  if (typeof cost === "string") {
    return { color: cost, value: "1", label: `${cost} mana cost` };
  }
  return {
    color: cost.color,
    value: cost.value ?? "1",
    label: cost.label ?? `${cost.color} mana cost`,
  };
});
---

<article class:list={["spell-card", color, accentClass, className]} {...rest}>
  <div class="card-header">
    <strong class="card-title">{title}</strong>
    <span class="mana-group">
      {
        costItems.map((cost) => (
          <span
            class:list={[
              "mana-cost",
              cost.color,
              cost.color !== "colorless" && `accent-${cost.color}`,
              cost.color !== "colorless" && "mana-accent",
            ]}
            aria-label={cost.label}
          >
            {cost.value}
          </span>
        ))
      }
    </span>
  </div>
  <div class="card-image">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={imageAlt}
          draggable={draggable}
          class={imageClass}
        />
      ) : (
        <div class="image-placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="card-body">
    <slot />

    {quote && <div class="card-quote">{'"' + quote + '"'}</div>}
  </div>
</article>

<style>
  .spell-card {
    font-size: 3vmin;
    height: round(21em, 2px);
    width: round(13em, 2px);
    --card-surface: var(--color-bg);
    --card-surface-soft: var(--color-bg-strong);
    --card-frame: var(--color-accent-bg, var(--color-bg));
    --card-frame-strong: var(--color-accent-bg-strong, var(--color-bg-strong));
    --card-text: var(--color-accent-text, var(--color-text));
    --card-text-muted: var(--color-text-ghost);
    --card-body: var(--color-bg-flat);
    --card-body-border: var(--color-border-subtle);
    --card-border: var(--color-border-strong);
    --card-image-border: var(--color-border-subtle);
    --card-image-border-soft: var(--color-border-subtle);
    --card-highlight: var(--color-fill-ghost);
    --card-shadow: var(--color-shadow-subtle);
    --card-shadow-soft: var(--color-shadow-ghost);
    background: var(--card-surface);
    border-radius: 0.62em;
    padding: round(0.38em, 1px);
    display: grid;
    grid-template-rows: auto 38% 1fr;
    gap: 0.5em;
    font-family: "Georgia", "Times New Roman", "Times", serif;
    border: 1px solid var(--card-border);
    box-shadow:
      0 0.95em 2.2em var(--card-shadow),
      inset 0 0.03em 0 var(--card-highlight),
      inset 0 -0.06em 0.19em var(--card-shadow-soft);
    transform: rotate(-2deg);
    background-image: linear-gradient(
      160deg,
      var(--card-surface-soft),
      var(--card-surface)
    );
    flex: none;
  }

  .spell-card.accent-water,
  .spell-card.accent-plant,
  .spell-card.accent-fire,
  .spell-card.accent-stone,
  .spell-card.accent-metal {
    --card-surface: var(--color-accent-bg, var(--color-bg));
    --card-surface-soft: var(--color-accent-fill, var(--color-bg-strong));
    --card-frame: var(--color-accent-fill, var(--color-accent-bg-strong));
    --card-frame-strong: var(--color-accent-fill-strong, var(--color-accent-border));
    --card-border: var(--color-accent-border, var(--color-border-strong));
    --card-image-border: var(--color-accent-border, var(--color-border-strong));
    --card-body: var(--color-bg-flat);
    --card-shadow: var(--color-accent-shadow, var(--color-shadow-subtle));
    --chip-shadow: var(--color-accent-shadow, var(--color-shadow-subtle));
  }

  /* TODO - adjust */
  .spell-card.accent-fire {
    --card-surface: var(--color-fire-bg-strong);
    --card-surface-soft: var(--color-fire-bg);
    --card-frame: var(--color-fire-bg-strong);
    --card-frame-strong: var(--color-fire-fill-strong);
    --card-border: var(--color-fire-bg-strong);
    --card-body: var(--color-fire-bg);
    --card-body-border: var(--color-fire-fill-strong);
  }

  [dir="rtl"] .spell-card {
    transform: rotate(2deg);
  }

  .spell-card.result {
    --card-surface: var(--color-fire-fill-strong);
    --card-surface-soft: var(--color-stone-bg);
    --card-frame: var(--color-stone-fill);
    --card-frame-strong: var(--color-fire-bg-strong);
    --card-border: var(--color-fire-bg-strong);
    --card-body-border: var(--color-fire-fill);
    --card-text: var(--color-text);
    --card-text-muted: var(--color-text-ghost);
    --card-shadow: var(--color-shadow-subtle);
    transform: none;
  }

  .spell-card .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.2em;
    font-size: 1em;
    letter-spacing: 0.02em;
    color: var(--card-text);
    padding: round(0.23em, 1px) round(0.38em, 1px);
    background: linear-gradient(
      180deg,
      var(--card-frame),
      var(--card-frame-strong)
    );
    border-radius: 0.38em;
    border: 1px solid var(--card-body-border);
    box-shadow: inset 0 0.03em 0 var(--card-highlight);
  }

  .spell-card .card-title {
    font-weight: 700;
    font-size: round(0.85em, 1px);
  }

  .spell-card .mana-group {
    display: inline-flex;
    gap: 0.1em;
  }

  .spell-card .mana-cost {
    width: round(1.23em, 2px);
    height: round(1.23em, 2px);
    border-radius: 50%;
    font-size: round(0.85em, 1px);
    --chip-bg: var(--color-fill);
    --chip-bg-strong: var(--color-bg-strong);
    --chip-text: var(--color-text);
    --chip-border: var(--color-border-strong);
    --chip-highlight: var(--color-fill-ghost);
    --chip-shadow: var(--color-shadow-subtle);
    color: var(--chip-text);
    background: radial-gradient(
      circle at top,
      var(--chip-bg),
      var(--chip-bg-strong) 70%
    );
    box-shadow:
      inset 0 0 0.23em var(--chip-highlight),
      0 0.23em 0.38em var(--chip-shadow);
    border: 1px solid var(--chip-border);
    display: grid;
    place-items: center;
    font-family: math;
    user-select: none;
  }

  .spell-card .mana-cost.mana-accent {
    --chip-bg: var(--color-accent-fill, var(--color-fill));
    --chip-bg-strong: var(--color-accent-fill-strong, var(--color-bg-strong));
    --chip-text: var(--color-accent-text, var(--color-text));
    --chip-border: var(--color-accent-border, var(--color-border-strong));
    --chip-shadow: var(--color-accent-shadow, var(--color-shadow-subtle));
  }

  .spell-card .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.55em;
    border: 1px solid var(--card-image-border);
  }

  .spell-card .image-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 0.55em;
    border: 1px solid var(--card-image-border-soft);
    background: linear-gradient(
      150deg,
      var(--card-frame),
      var(--card-surface-soft)
    );
  }

  .spell-card .card-body {
    background: var(--card-body);
    border-radius: 0.55em;
    padding: 0.75em;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-size: 0.8em;
    border: 1px solid var(--card-body-border);
    color: var(--card-text);
  }

  .spell-card .card-body p {
    margin: 0;
  }

  .spell-card .card-quote {
    margin-top: auto;
    font-size: 0.85em;
    color: var(--card-text-muted);
    line-height: 1.5;

    font-style: italic;
  }

  .spell-card .card-quote:empty {
    display: none;
  }

  .base {
    transform: rotate(-4deg);
  }

  [dir="rtl"] .base {
    transform: rotate(4deg);
  }

  .overlap {
    margin-inline-start: -8em;
    margin-top: 2em;
    transform: rotate(4deg);
  }

  [dir="rtl"] .overlap {
    transform: rotate(-4deg);
  }
</style>
