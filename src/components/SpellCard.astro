---
import type { HTMLAttributes } from "astro/types";
import type { AccentKey } from "../data/paletteSnapshots";
import ManaBadge from "./ManaBadge.astro";

type ManaItem =
  | string
  | number
  | {
      value: string | number;
      accent?: AccentKey;
      label?: string;
    };

interface Props extends Omit<HTMLAttributes<"article">, "data-accent"> {
  accent?: AccentKey;
  title?: string;
  mana?: string | number;
  manas?: ManaItem[];
  imageSrc: string;
  imageAlt?: string;
  lines?: string[];
  quote?: string;
}

const {
  accent,
  title = "Driving",
  mana = "1",
  manas,
  imageSrc,
  imageAlt = "Driving card artwork",
  lines = ["control the vehicle", "obey road signs", "blend in traffic"],
  quote,
  class: className,
  ...rest
}: Props = Astro.props;

const manaItems = (manas && manas.length > 0 ? manas : [mana]).map((item) => {
  if (typeof item === "string" || typeof item === "number") {
    return {
      value: item,
      accent,
      label: "Mana cost",
    };
  }

  return {
    value: item.value,
    accent: item.accent ?? accent,
    label: item.label ?? "Mana cost",
  };
});
---

<article
  {...rest}
  data-accent={accent}
  class:list={["spellcard-template", className]}
>
  <div class="spellcard-header">
    <strong class="spellcard-title">{title}</strong>
    <span class="spellcard-mana-group" aria-label="Mana costs">
      {
        manaItems.map((item) => (
          <ManaBadge
            value={item.value}
            accent={item.accent}
            aria-label={item.label}
          />
        ))
      }
    </span>
  </div>

  <div class="spellcard-image-slot" aria-label="Card artwork">
    <img class="spellcard-image" src={imageSrc} alt={imageAlt} />
  </div>

  <div class="spellcard-content">
    <div class="spellcard-lines" aria-label="Card text">
      {lines.map((line) => <p>{line}</p>)}
    </div>
    {quote && <p class="spellcard-quote">{quote}</p>}
  </div>
</article>

<style>
  .spellcard-template {
    --color-card-surface: var(--color-accent-surface);
    --color-card-highlight: var(--color-accent-highlight);
    --color-card-content-surface: var(--color-content-surface);

    font-size: 0.86em;
    width: 13em;
    height: 21em;
    margin: 0;
    min-height: 0;
    position: relative;
    border-radius: 1em;
    background: var(--color-card-surface);
    border: 1px solid rgba(0, 0, 0, 0.14);
    box-shadow:
      0 0.58em 1.45em rgba(0, 0, 0, 0.07),
      inset 0 0.07em 0 rgba(255, 255, 255, 0.72);
    overflow: hidden;
    display: grid;
    grid-template-rows: 9fr 38fr 53fr;
    align-content: stretch;
    gap: 0;
    flex: none;
  }

  .spellcard-header,
  .spellcard-image-slot,
  .spellcard-content {
    min-height: 0;
  }

  .spellcard-header {
    border-radius: 0.72em 0.72em 0 0;
    background: var(--color-card-surface);
    color: var(--ink);
    padding-block: 0;
    padding-inline: 0.62em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7em;
  }

  .spellcard-title {
    font-size: 1.16em;
    letter-spacing: 0.01em;
  }

  .spellcard-mana-group {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.12em;
    flex: none;
    direction: ltr;
    line-height: 1;
    white-space: nowrap;
  }

  .spellcard-image-slot {
    border-radius: 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(0, 0, 0, 0.15);
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.5),
        rgba(255, 255, 255, 0.18)
      ),
      repeating-linear-gradient(
        -45deg,
        rgba(0, 0, 0, 0.03) 0 8px,
        rgba(0, 0, 0, 0.06) 8px 16px
      );
  }

  .spellcard-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .spellcard-content {
    border-radius: 0 0 0.72em 0.72em;
    background: var(--color-card-content-surface);
    color: var(--ink);
    border-top: 0;
    padding: 0.38em 0.62em;
    overflow: auto;
    display: grid;
    gap: 0.4em;
  }

  .spellcard-lines p {
    margin: 0;
    font-size: 1em;
    line-height: 1.25;
    opacity: 0.9;
  }

  .spellcard-quote {
    margin: auto 0 0 0;
    font-size: 0.76em;
    line-height: 1.35;
    font-style: italic;
    opacity: 0.62;
  }

  .spellcard-quote::before {
    content: '"';
  }

  .spellcard-quote::after {
    content: '"';
  }
</style>
