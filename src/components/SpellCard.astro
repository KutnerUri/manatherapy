---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  color?: "white" | "blue" | "red" | "black";
  quote?: string;
  title?: string;
  costs?: Array<
    | string
    | {
        color: string;
        value?: string;
        label?: string;
      }
  >;
  image?: ImageMetadata;
  imageAlt?: string;
  imageClass?: string;
  draggable?: boolean;
}

const {
  class: className,
  color,
  quote,
  title = "",
  costs = [],
  image,
  imageAlt = "",
  imageClass = "main",
  draggable,
  ...rest
}: Props = Astro.props;

const imageSrc = image?.src;
const costItems = costs.map((cost) => {
  if (typeof cost === "string") {
    return { color: cost, value: "1", label: `${cost} mana cost` };
  }
  return {
    color: cost.color,
    value: cost.value ?? "1",
    label: cost.label ?? `${cost.color} mana cost`,
  };
});
---

<article class:list={["spell-card", color, className]} {...rest}>
  <div class="card-header">
    <strong class="card-title">{title}</strong>
    <span class="mana-group">
      {
        costItems.map((cost) => (
          <span class={`mana-cost ${cost.color}`} aria-label={cost.label}>
            {cost.value}
          </span>
        ))
      }
    </span>
  </div>
  <div class="card-image">
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={imageAlt}
          draggable={draggable}
          class={imageClass}
        />
      ) : (
        <div class="image-placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="card-body">
    <slot />

    {quote && <div class="card-quote">{'"' + quote + '"'}</div>}
  </div>
</article>

<style>
  .spell-card {
    font-size: 3vmin;
    height: round(21em, 2px);
    width: round(13em, 2px);
    background: var(--card-surface, #f2f4f8);
    border-radius: 0.62em;
    padding: round(0.38em, 1px);
    display: grid;
    grid-template-rows: auto 38% 1fr;
    gap: 0.5em;
    font-family: "Georgia", "Times New Roman", "Times", serif;
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow:
      0 0.95em 2.2em rgba(0, 0, 0, 0.18),
      inset 0 0.03em 0 rgba(255, 255, 255, 0.9),
      inset 0 -0.06em 0.19em rgba(0, 0, 0, 0.06);
    transform: rotate(-2deg);
    background-image: linear-gradient(
      160deg,
      var(--card-surface-soft, #f8f9fc),
      var(--card-surface, #f2f4f8)
    );
    flex: none;
    --card-body: #ffffff;
    --card-body-border: rgba(0, 0, 0, 0.08);
    --card-body-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.75);
  }

  [dir="rtl"] .spell-card {
    transform: rotate(2deg);
  }

  .spell-card.white {
    --card-surface: #f7f7f3;
    --card-frame: #ebeae4;
    --card-frame-strong: #d7d4cc;
    --card-surface-soft: #fbfbf8;
    --card-text: #2a2a24;
    --card-text-muted: rgba(42, 42, 36, 0.6);
  }

  .spell-card.red {
    --card-surface: #f6e1dc;
    --card-frame: #edc9c0;
    --card-frame-strong: #dfab9f;
    --card-surface-soft: #fbeee9;
    --card-text: #3a1f1c;
    --card-text-muted: rgba(58, 31, 28, 0.6);
  }

  .spell-card.black {
    --card-surface: #1a121f;
    --card-frame: #2a1d34;
    --card-frame-strong: #3b2a4a;
    --card-surface-soft: #231926;
    --card-text: #f1efe6;
    --card-text-muted: rgba(241, 239, 230, 0.65);
    --card-body: #33243f;
    --card-body-border: rgba(255, 255, 255, 0.14);
    --card-body-shadow: none;
  }

  /* keep blue, we'll need it later */
  .spell-card.blue {
    --card-surface: #e6efff;
    --card-frame: #d2e1f6;
    --card-frame-strong: #b7c9e5;
    --card-surface-soft: #f4f8ff;
    --card-text: #1b2738;
    --card-text-muted: rgba(27, 39, 56, 0.6);
  }

  .spell-card.result {
    --card-surface: #f1d8cf;
    --card-frame: hsl(62, 35%, 90%);
    --card-frame-strong: hsl(23, 38%, 76%);
    --card-surface-soft: #fbfbf4;
    --card-text: #2b2622;
    --card-text-muted: rgba(43, 38, 34, 0.6);
    transform: none;
  }

  .spell-card .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.2em;
    font-size: 1em;
    letter-spacing: 0.02em;
    color: var(--card-text, #1b2738);
    padding: round(0.23em, 1px) round(0.38em, 1px);
    background: linear-gradient(
      180deg,
      var(--card-frame, #d8e0ee),
      var(--card-frame-strong, #c1cadd)
    );
    border-radius: 0.38em;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: inset 0 0.03em 0 rgba(255, 255, 255, 0.8);
  }

  .spell-card .card-title {
    font-weight: 700;
    font-size: round(0.85em, 1px);
  }

  .spell-card .mana-group {
    display: inline-flex;
    gap: 0.1em;
  }

  .spell-card .mana-cost {
    width: round(1.23em, 2px);
    height: round(1.23em, 2px);
    border-radius: 50%;
    font-size: round(0.85em, 1px);
    color: #1b2738;
    background: radial-gradient(circle at top, #f1f4fb, #d0d7e6 70%);
    box-shadow:
      inset 0 0 0.23em rgba(255, 255, 255, 0.7),
      0 0.23em 0.38em rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(0, 0, 0, 0.12);
    display: grid;
    place-items: center;
    font-family: math;
    user-select: none;
  }

  .spell-card .mana-cost.white {
    color: #3a3a3a;
    background: radial-gradient(circle at top, #ffffff, #d9d9d3 70%);
  }

  .spell-card .mana-cost.red {
    color: #6b1e1e;
    background: radial-gradient(circle at top, #f7d8d1, #e59f93 70%);
  }

  .spell-card .mana-cost.black {
    color: #f1efe6;
    background: radial-gradient(circle at top, #3a3f4a, #16181f 70%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      inset 0 0 0.23em rgba(255, 255, 255, 0.12),
      0 0.23em 0.38em rgba(0, 0, 0, 0.45);
  }

  .spell-card .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.55em;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .spell-card .image-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 0.55em;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(
      150deg,
      var(--card-frame, #d8e0ee),
      var(--card-surface-soft, #f8f9fc)
    );
  }

  .spell-card .card-body {
    background: var(--card-body);
    border-radius: 0.55em;
    padding: 0.75em;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-size: 0.8em;
    border: 1px solid var(--card-body-border);
    color: var(--card-text, #1b2738);
  }

  .spell-card .card-body p {
    margin: 0;
  }

  .spell-card .card-quote {
    margin-top: auto;
    font-size: 0.85em;
    color: var(--card-text-muted, rgba(27, 39, 56, 0.6));
    line-height: 1.5;

    font-style: italic;
  }

  .spell-card .card-quote:empty {
    display: none;
  }

  .base {
    transform: rotate(-4deg);
  }

  [dir="rtl"] .base {
    transform: rotate(4deg);
  }

  .overlap {
    margin-inline-start: -8em;
    margin-top: 2em;
    transform: rotate(4deg);
  }

  [dir="rtl"] .overlap {
    transform: rotate(-4deg);
  }
</style>
