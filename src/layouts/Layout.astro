---
import type { HTMLAttributes } from "astro/types";
import HamburgerMenu from "../components/HamburgerMenu.astro";
import defaultOgImage from "../assets/5-elem.jpg";
import defaultFavicon from "../favicon.svg";

interface Props extends HTMLAttributes<"body"> {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: ImageMetadata | string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: ImageMetadata | string;
  favicon?: ImageMetadata | string;
}

const {
  title = "",
  description,
  lang = "en",
  dir = "rtl",
  ogTitle = title,
  ogDescription = description,
  ogImage = defaultOgImage,
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  twitterImage = ogImage,
  favicon = defaultFavicon,
  class: className,
  ...rest
}: Props = Astro.props;

const ogImageSrc = ogImage && (ogImage.src ?? ogImage);
const twitterImageSrc = twitterImage && (twitterImage.src ?? twitterImage);
const faviconSrc = favicon && (favicon.src ?? favicon);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {
      ogDescription && (
        <meta property="og:description" content={ogDescription} />
      )
    }
    {ogImageSrc && <meta property="og:image" content={ogImageSrc} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
    {
      twitterDescription && (
        <meta name="twitter:description" content={twitterDescription} />
      )
    }
    {twitterImageSrc && <meta name="twitter:image" content={twitterImageSrc} />}
    {faviconSrc && <link rel="icon" href={faviconSrc} type="image/svg+xml" />}
    <title>{title}</title>
  </head>
  <body dir={dir} class:list={["theme-main", className]} {...rest}>
    <HamburgerMenu />
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
  }

  .theme-main {
    font-family: "Georgia", "Times New Roman", "Times", serif;
    --color-bg: #f8f2e8;
    --color-bg-strong: #efe7d8;
    --color-bg-flat: #ffffff;
    --color-bg-gradient: linear-gradient(
      140deg,
      #f7f1eb 0%,
      #efe2d2 60%,
      #f2d9d3
    );
    --color-text: #141414;
    --color-text-ghost: rgba(42, 42, 36, 0.6);
    --color-fg: #141414;
    --color-fill: #f1efe6;
    --color-fill-ghost: rgba(255, 255, 255, 0.22);
    --color-border-subtle: rgba(0, 0, 0, 0.08);
    --color-border-strong: rgba(0, 0, 0, 0.12);
    --color-shadow-ghost: rgba(0, 0, 0, 0.08);
    --color-shadow-faint: rgba(0, 0, 0, 0.12);
    --color-shadow-subtle: rgba(0, 0, 0, 0.18);
    --color-shadow-strong: rgba(0, 0, 0, 0.28);
    --color-shadow-dense: rgba(0, 0, 0, 0.35);
    --color-shadow-sharp: rgba(0, 0, 0, 0.45);
    --color-shadow-full: rgba(0, 0, 0, 0.5);
    --color-favicon-fill-full: #424242;
    --color-water-bg: #e6f0fb;
    --color-water-bg-strong: #c7d7ec;
    --color-water-fill: #d7e6f4;
    --color-water-fill-strong: #9fb8d6;
    --color-water-text: #08192a;
    --color-water-fg: #1b2738;
    --color-water-shadow: rgba(159, 184, 214, 0.4);
    --color-water-border: #d2e1f6;
    --color-plant-bg: #e7f1e2;
    --color-plant-bg-strong: #cfe3cc;
    --color-plant-fill: #dfeedd;
    --color-plant-fill-strong: #9fbf98;
    --color-plant-text: #0d2b17;
    --color-plant-fg: #0d2b17;
    --color-plant-shadow: rgba(159, 191, 152, 0.4);
    --color-plant-border: #b7d0b3;
    --color-fire-bg: #f0b4a6;
    --color-fire-bg-strong: #d47264;
    --color-fire-fill: #f5c6bb;
    --color-fire-fill-strong: #f08d7b;
    --color-fire-text: #3b0f0a;
    --color-fire-fg: #3b0f0a;
    --color-fire-shadow: rgba(240, 141, 123, 0.4);
    --color-fire-border: #dfab9f;
    --color-stone-bg: #fffef9;
    --color-stone-bg-strong: #fff7e6;
    --color-stone-fill: #fff2d6;
    --color-stone-fill-strong: #ffe7bf;
    --color-stone-text: #4a3512;
    --color-stone-fg: #4a3512;
    --color-stone-shadow: rgba(242, 200, 95, 0.4);
    --color-stone-border: #f1db9b;
    --color-metal-bg: #240a34;
    --color-metal-bg-strong: #120012;
    --color-metal-fill: #3a3f4a;
    --color-metal-fill-strong: #16181f;
    --color-metal-text: #f1efe6;
    --color-metal-fg: #f1efe6;
    --color-metal-shadow: rgba(22, 24, 31, 0.35);
    --color-metal-border: #3b2a4a;
    --color-shadow-light: rgba(255, 255, 255, 0.35);
    --color-glow-strong: rgba(255, 255, 255, 0.85);
    --color-glow: rgba(255, 255, 255, 0.65);
    color: var(--color-text);
    background: var(--color-bg-gradient);
  }

  .accent-metal,
  .accent-black {
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    --color-bg: #120012;
    --color-bg-strong: #1a0d24;
    --color-bg-flat: #0c0612;
    --color-bg-gradient: radial-gradient(circle at top, #1b0a24, #0c0612);
    --color-text: #f1efe6;
    --color-text-ghost: rgba(241, 239, 230, 0.65);
    --color-fg: #f1efe6;
    --color-fill: #f1efe6;
    --color-fill-ghost: rgba(255, 255, 255, 0.22);
    --color-border-subtle: rgba(255, 255, 255, 0.08);
    --color-border-strong: rgba(255, 255, 255, 0.16);
    --color-shadow-ghost: rgba(255, 255, 255, 0.08);
    --color-shadow-faint: rgba(0, 0, 0, 0.5);
    --color-metal-mist: rgba(40, 24, 56, 0.18);
    --color-metal-core: #080008;
    --color-metal-core-strong: rgba(8, 0, 8, 0.92);
    --color-metal-aura: rgba(78, 38, 112, 0.32);
    --color-metal-aura-soft: rgba(78, 38, 112, 0.12);
    --color-metal-panel-bg: rgba(10, 6, 16, 0.55);
    /* TODO: improve naming for metal gradient tokens */
    --color-accent-bg: var(--color-metal-bg);
    --color-accent-bg-strong: var(--color-metal-bg-strong);
    --color-accent-fill: var(--color-metal-fill);
    --color-accent-fill-strong: var(--color-metal-fill-strong);
    --color-accent-text: var(--color-metal-text);
    --color-accent-fg: var(--color-metal-fg);
    --color-accent-shadow: var(--color-metal-shadow);
    --color-accent-border: var(--color-metal-border);
    color: var(--color-text);
    background: var(--color-bg-gradient);
  }

  .accent-water,
  .accent-blue {
    font-family: Arial, Helvetica, sans-serif;
    --color-accent-bg: var(--color-water-bg);
    --color-accent-bg-strong: var(--color-water-bg-strong);
    --color-accent-fill: var(--color-water-fill);
    --color-accent-fill-strong: var(--color-water-fill-strong);
    --color-accent-text: var(--color-water-text);
    --color-accent-fg: var(--color-water-fg);
    --color-accent-shadow: var(--color-water-shadow);
    --color-accent-border: var(--color-water-border);
  }

  .accent-plant,
  .accent-green {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
    --color-accent-bg: var(--color-plant-bg);
    --color-accent-bg-strong: var(--color-plant-bg-strong);
    --color-accent-fill: var(--color-plant-fill);
    --color-accent-fill-strong: var(--color-plant-fill-strong);
    --color-accent-text: var(--color-plant-text);
    --color-accent-fg: var(--color-plant-fg);
    --color-accent-shadow: var(--color-plant-shadow);
    --color-accent-border: var(--color-plant-border);
  }

  .accent-fire,
  .accent-red {
    font-family:
      "Trebuchet MS", "Lucida Sans Unicode", "Lucida Grande", "Lucida Sans",
      Arial, sans-serif;
    --color-accent-bg: var(--color-fire-bg);
    --color-accent-bg-strong: var(--color-fire-bg-strong);
    --color-accent-fill: var(--color-fire-fill);
    --color-accent-fill-strong: var(--color-fire-fill-strong);
    --color-accent-text: var(--color-fire-text);
    --color-accent-fg: var(--color-fire-fg);
    --color-accent-shadow: var(--color-fire-shadow);
    --color-accent-border: var(--color-fire-border);
  }

  .accent-stone,
  .accent-yellow,
  .accent-white {
    font-family: "Times New Roman", Times, Georgia, serif;
    --color-accent-bg: var(--color-stone-bg);
    --color-accent-bg-strong: var(--color-stone-bg-strong);
    --color-accent-fill: var(--color-stone-fill);
    --color-accent-fill-strong: var(--color-stone-fill-strong);
    --color-accent-text: var(--color-stone-text);
    --color-accent-fg: var(--color-stone-fg);
    --color-accent-shadow: var(--color-stone-shadow);
    --color-accent-border: var(--color-stone-border);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body,
  main {
    height: 100%;
  }
</style>
