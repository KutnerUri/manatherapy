---
import type { HTMLAttributes } from "astro/types";
import HamburgerMenu from "../components/HamburgerMenu.astro";
import ThemeScript from "../components/ThemeScript.astro";
import defaultOgImage from "../assets/5-elem.jpg";
import defaultFavicon from "../favicon.svg";

interface Props extends HTMLAttributes<"body"> {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: ImageMetadata | string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: ImageMetadata | string;
  favicon?: ImageMetadata | string;
}

const {
  title = "",
  description,
  lang = "he",
  dir = "rtl",
  ogTitle = title,
  ogDescription = description,
  ogImage = defaultOgImage,
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  twitterImage = ogImage,
  favicon = defaultFavicon,
  class: className,
  ...rest
}: Props = Astro.props;

const ogImageSrc = ogImage && (ogImage.src ?? ogImage);
const twitterImageSrc = twitterImage && (twitterImage.src ?? twitterImage);
const faviconSrc = favicon && (favicon.src ?? favicon);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {
      ogDescription && (
        <meta property="og:description" content={ogDescription} />
      )
    }
    {ogImageSrc && <meta property="og:image" content={ogImageSrc} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
    {
      twitterDescription && (
        <meta name="twitter:description" content={twitterDescription} />
      )
    }
    {twitterImageSrc && <meta name="twitter:image" content={twitterImageSrc} />}
    {faviconSrc && <link rel="icon" href={faviconSrc} type="image/svg+xml" />}
    <ThemeScript />
    <title>{title}</title>
  </head>
  <body dir={dir} class:list={["theme-main", className]} {...rest}>
    <HamburgerMenu />
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    color: var(--ink);
    background: var(--color-wallpaper);
  }

  .theme-main {
    font-family: "Georgia", "Times New Roman", "Times", serif;
    --color-bg-gradient: linear-gradient(
      180deg,
      rgb(255 255 255 / 56%),
      var(--color-wallpaper)
    );
    --ink: #141414;
    --ink-soft: rgb(32 32 32 / 72%);
    --fx-border-subtle: rgb(0 0 0 / 10%);
    --fx-border-strong: rgb(0 0 0 / 16%);
    --fx-shadow-ghost: rgb(0 0 0 / 5%);
    --fx-shadow-soft: rgb(0 0 0 / 10%);
    --fx-shadow-subtle: rgb(0 0 0 / 12%);
    --fx-shadow-strong: rgb(0 0 0 / 18%);
    --fx-shadow-dense: rgb(0 0 0 / 18%);
    --fx-shadow-sharp: rgb(0 0 0 / 18%);
    --fx-shadow-full: rgb(0 0 0 / 52%);
    --fx-light-glow: rgb(0 0 0 / 32%);
    --fx-light-glow-strong: rgb(0 0 0 / 46%);
    --fx-highlight: rgba(255, 255, 255, 0.7);
    color-scheme: light;

    --token-colorless-wallpaper: #fbfbfb;
    --token-colorless-surface: #f2f2f2;
    --token-colorless-content: #fefefe;
    --token-colorless-highlight: #e9e9e9;
    --token-colorless-full: #d7d7d7;

    --token-earth-wallpaper: #fefbe8;
    --token-earth-surface: #f8f3d5;
    --token-earth-content: #fefefe;
    --token-earth-highlight: #f2eab4;
    --token-earth-full: #e6d35c;

    --token-water-wallpaper: #f8fafd;
    --token-water-surface: #eaf3ff;
    --token-water-content: #fefefe;
    --token-water-highlight: #d6e7ff;
    --token-water-full: #a2c7ff;

    --token-plant-wallpaper: #f0fff0;
    --token-plant-surface: #d2f1d4;
    --token-plant-content: #fefefe;
    --token-plant-highlight: #a9e8ad;
    --token-plant-full: #63c96b;

    --token-fire-wallpaper: #fef9f8;
    --token-fire-surface: #ffe3e1;
    --token-fire-content: #fefefe;
    --token-fire-highlight: #ffc4c5;
    --token-fire-full: #ff3d49;

    --token-metal-wallpaper: #f7f0ff;
    --token-metal-surface: #ecd9ff;
    --token-metal-content: #fefefe;
    --token-metal-highlight: #d6b8ff;
    --token-metal-full: #9a5dff;

    --color-accent-wallpaper: var(--token-colorless-wallpaper);
    --color-accent-surface: var(--token-colorless-surface);
    --color-content-surface: var(--token-colorless-content);
    --color-accent-highlight: var(--token-colorless-highlight);
    --color-accent-full: var(--token-colorless-full);
    --color-wallpaper: var(--color-accent-wallpaper);

    color: var(--ink);
    background: var(--color-wallpaper);
  }

  .theme-main[data-theme="dark"],
  [data-theme="dark"] .theme-main {
    --color-bg-gradient: linear-gradient(
      180deg,
      rgb(25 25 25 / 84%),
      var(--color-wallpaper)
    );
    --ink: #f5f5f5;
    --ink-soft: rgb(245 245 245 / 76%);
    --fx-border-subtle: rgb(255 255 255 / 22%);
    --fx-border-strong: rgb(255 255 255 / 31%);
    --fx-shadow-ghost: rgb(255 255 255 / 7%);
    --fx-shadow-soft: rgb(0 0 0 / 24%);
    --fx-shadow-subtle: rgb(0 0 0 / 42%);
    --fx-shadow-strong: rgb(0 0 0 / 52%);
    --fx-shadow-dense: rgb(0 0 0 / 52%);
    --fx-shadow-sharp: rgb(0 0 0 / 52%);
    --fx-shadow-full: rgb(255 255 255 / 72%);
    --fx-light-glow: rgb(0 0 0 / 44%);
    --fx-light-glow-strong: rgb(0 0 0 / 56%);
    --fx-highlight: rgb(255 255 255 / 31%);
    color-scheme: dark;
    --token-colorless-wallpaper: #121316;
    --token-colorless-surface: #1f2229;
    --token-colorless-content: #171717;
    --token-colorless-highlight: #4c525e;
    --token-colorless-full: #616977;

    --token-earth-wallpaper: #120f08;
    --token-earth-surface: #2c2414;
    --token-earth-content: #171717;
    --token-earth-highlight: #5a4b23;
    --token-earth-full: #886b10;

    --token-water-wallpaper: #081226;
    --token-water-surface: #182a49;
    --token-water-content: #171717;
    --token-water-highlight: #385880;
    --token-water-full: #316fc8;

    --token-plant-wallpaper: #07150e;
    --token-plant-surface: #183428;
    --token-plant-content: #171717;
    --token-plant-highlight: #3a654b;
    --token-plant-full: #2b7e4a;

    --token-fire-wallpaper: #180b11;
    --token-fire-surface: #3a1724;
    --token-fire-content: #171717;
    --token-fire-highlight: #7e4657;
    --token-fire-full: #c53d5a;

    --token-metal-wallpaper: #0f0a1d;
    --token-metal-surface: #251a42;
    --token-metal-content: #171717;
    --token-metal-highlight: #5b487f;
    --token-metal-full: #7f53ce;
  }

  [data-accent="colorless"],
  .accent-colorless {
    --color-accent-wallpaper: var(--token-colorless-wallpaper);
    --color-accent-surface: var(--token-colorless-surface);
    --color-content-surface: var(--token-colorless-content);
    --color-accent-highlight: var(--token-colorless-highlight);
    --color-accent-full: var(--token-colorless-full);
  }

  [data-accent="earth"],
  .accent-earth {
    --color-accent-wallpaper: var(--token-earth-wallpaper);
    --color-accent-surface: var(--token-earth-surface);
    --color-content-surface: var(--token-earth-content);
    --color-accent-highlight: var(--token-earth-highlight);
    --color-accent-full: var(--token-earth-full);
  }

  [data-accent="water"],
  .accent-water {
    --color-accent-wallpaper: var(--token-water-wallpaper);
    --color-accent-surface: var(--token-water-surface);
    --color-content-surface: var(--token-water-content);
    --color-accent-highlight: var(--token-water-highlight);
    --color-accent-full: var(--token-water-full);
  }

  [data-accent="plant"],
  .accent-plant {
    --color-accent-wallpaper: var(--token-plant-wallpaper);
    --color-accent-surface: var(--token-plant-surface);
    --color-content-surface: var(--token-plant-content);
    --color-accent-highlight: var(--token-plant-highlight);
    --color-accent-full: var(--token-plant-full);
  }

  [data-accent="fire"],
  .accent-fire {
    --color-accent-wallpaper: var(--token-fire-wallpaper);
    --color-accent-surface: var(--token-fire-surface);
    --color-content-surface: var(--token-fire-content);
    --color-accent-highlight: var(--token-fire-highlight);
    --color-accent-full: var(--token-fire-full);
  }

  [data-accent="metal"],
  .accent-metal {
    --color-accent-wallpaper: var(--token-metal-wallpaper);
    --color-accent-surface: var(--token-metal-surface);
    --color-content-surface: var(--token-metal-content);
    --color-accent-highlight: var(--token-metal-highlight);
    --color-accent-full: var(--token-metal-full);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body,
  main {
    height: 100%;
  }
</style>
