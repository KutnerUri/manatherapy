---
import LineFade from "../components/LineFade.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import Layout from "../layouts/Layout.astro";
import gettingWhatYouWantImage from "../assets/getting-what-you-want.webp";
import settingBordersImage from "../assets/setting-borders.webp";
import workDoneImage from "../assets/work-done.webp";
import choosingImage from "../assets/choosing.webp";
import extractionImage from "../assets/extraction.webp";
import metalLogo from "../assets/logos/metal.webp";

const title = "כבוד — מאנה תרפיה";
const description = "Black mana - honor, pragmatism, and survival.";
---

<Layout title={title} description={description} lang="he" class="accent-metal">
  <Slideshow>
    <ManaSlide
      colorClass="black"
      logo={metalLogo}
      logoAlt="Black mana logo"
      sub="כבוד"
      subtitle="סיפוק צרכים"
      slide={0}
    >
      <ScrollHint />
    </ManaSlide>

    <Slide class="text-slide slide-metal" slide={1}>
      <SlideInner>
        <SectionTitle>כבוד הוא הכוח לדאוג לעצמנו.</SectionTitle>
        <LineFade
          lines={["הוא שואל:", "מה אני רוצה?", "איך אני משיג את זה?"]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-metal" slide={2}>
      <SlideInner>
        <SectionTitle>תפיסת עולם</SectionTitle>
        <LineFade
          lines={[
            "כבוד מניח שהעולם קשה,",
            "שהמשאבים מוגבלים,",
            "ושאף אחד לא יבוא להציל אותך.",
            "",
            "מתוך ההנחה הזו, כבוד מעריך:",
            "תועלת עצמית,",
            "אמביציה,",
            "והתמודדות עם אמיתות לא נעימות.",
            "כבוד לא מתחבא מאחורי כוונות טובות, דיונים תאורטיים, ותירוצים.",
            "",
            "הוא אומר:",
            "אם אתה רוצה משהו",
            "אתה משלם",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-metal" slide={3}>
      <SlideInner>
        <SectionTitle>למה צריך כבוד</SectionTitle>
        <LineFade
          lines={[
            "כבוד נותן לנו אנכיות -",
            "נקודת מבט סובייקטיבית שממנה ניתן לקבל החלטות, גם אם הן קשות.",
            "בלעדיו - אין עצמי. כל דבר הופך להיות מרוחק ותאורטי",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="slide-metal" slide={4}>
      <SectionTitle>מה כבוד מאפשר לנו</SectionTitle>
      <div class="spell-card-row">
        <SpellCard
          color="black"
          title="לבחור"
          costs={["black"]}
          image={choosingImage}
          imageAlt="Choosing spell illustration"
          quote="זה קל לבחור כשאתה יודע מה אתה רוצה"
        >
          דלג על דילמה
        </SpellCard>
        <SpellCard
          color="black"
          title="מציב גבולות"
          costs={["black"]}
          image={settingBordersImage}
          imageAlt="Setting borders spell illustration"
          quote="אני לא מוכן, זה יקר מדי"
        >
          סרב לדרישה או ציפייה
        </SpellCard>
        <SpellCard
          color="black"
          title="אמביציה"
          costs={[
            "black",
            { color: "colorless", value: "X", label: "עלות שחור" },
          ]}
          image={workDoneImage}
          imageAlt="Paying prices spell illustration"
          quote="אם זה היה קל, כולם היו עושים את זה"
        >
          התמודד עם אי-נוחות זמנית.
          <br />
          התקדם X צעדים לכיוון היעד שלך.
        </SpellCard>
        <SpellCard
          color="black"
          title="להשיג מה שאני רוצה"
          costs={["black", "black", "black"]}
          image={gettingWhatYouWantImage}
          imageAlt="Getting what you want spell illustration"
          quote="זה מגיע לי"
        >
          קח דבר מה שאתה רוצה.
          <br />
          <br />
          במקום לשלם מאנה, ניתן להקריב משהו כתמורה.
        </SpellCard>
      </div>
    </Slide>

    <Slide class="slide-metal" slide={5}>
      <div class="spell-card-row">
        <SpellCard
          color="black"
          title="מניפולציה"
          quote="הוא לא צריך לדעת הכל... כל עוד הוא מרוויח"
          costs={["black", "black"]}
        >
          השפע על מישהו לטובתך.
          <br />
          <br />
          שלם עוד 2 מאנה אם אין לו אינטרס.
          <br />
          ועוד 3 אם זה נוגד את האינטרס שלו.
        </SpellCard>
        <SpellCard
          color="black"
          title="הלוואה"
          quote="העתיד יכול לחכות, אני צריך את זה עכשיו"
          costs={["black"]}
        >
          קבל כסף עכשיו, והחזר פי שתיים בעוד 10 תורות.
        </SpellCard>
        <SpellCard
          color="black"
          title="הפק תועלת"
          quote="אם ככה, לפחות אני אצא מזה עם משהו"
          costs={["black"]}
          image={extractionImage}
          imageAlt="Extraction spell illustration"
        >
          קח מצב רע, או משהו שנגמר, ותוציא ממנו ערך.
        </SpellCard>
      </div>
    </Slide>

    <Slide class="text-slide slide-metal" slide={6}>
      <SlideInner>
        <SectionTitle>יצירה של מאנה שחורה</SectionTitle>
        <div class="creation-grid">
          <article class="creation-card">
            <h3>בדיקת רצון</h3>
            <p>בכל פעם שיש ספק, לשאול - מה אני רוצה?</p>
          </article>
          <article class="creation-card">
            <h3>הערכה לרצון</h3>
            <p>אם אני רוצה את זה, זה חשוב</p>
          </article>
          <article class="creation-card">
            <h3>מודעות למחיר</h3>
            <p>מה המחיר המלא למה שאני רוצה? האם אני מוכן לשלם אותו?</p>
          </article>
          <article class="creation-card">
            <h3>הערכה לסיפוק</h3>
            <p>האם אני מרוצה ממה שקיבלתי?</p>
          </article>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-metal" slide={7}>
      <SlideInner>
        <SectionTitle>התפתחות</SectionTitle>
        <div class="development-grid">
          <article class="development-card">
            <h3>כבוד ילדותי</h3>
            <p>
              ממהר לספק צרכים, אך נוטה להתעלם מהמחיר ומההשלכות שלו על אחרים
              והעתיד.
            </p>
            <p>
              הוא מבלבל בין סיפוק מיידי וסיפוק אמיתי, מתקשה להציב גבולות ברורים,
              וכשדברים משתבשים הוא חוזר לתחושת קורבנות.
            </p>
          </article>
          <article class="development-card">
            <h3>כבוד בוגר</h3>
            <p>מכיר בצרכיו ומספק אותם במידה הנכונה.</p>
            <p>
              הוא מסוגל לדחות סיפוק או לתת לצרכים להתפוגג, מקבל החלטות מתוך
              חישוב עלות־תועלת בריא, מציב גבולות שקטים וברורים, ולוקח אחריות על
              התוצאות.
            </p>
          </article>
        </div>
      </SlideInner>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .slide-metal {
    background: var(--color-bg-gradient) !important;
  }

  .spell-card-row {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
    max-width: 86%;
  }

  .spell-card-row .spell-card {
    transform: none !important;
  }

  @media (max-width: 1100px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }


  .creation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
    margin-top: 1.5rem;
  }

  .creation-card {
    padding: clamp(1.2rem, 2.6vw, 2rem);
    border-radius: 18px;
    background: rgba(10, 6, 16, 0.55);
    box-shadow:
      0 18px 35px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .creation-card h3 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    letter-spacing: 0.05em;
  }

  .creation-card p {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .creation-grid {
      grid-template-columns: 1fr;
    }
  }

  .development-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: 1.5rem;
  }

  .development-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 20px;
    background: rgba(10, 6, 16, 0.55);
    box-shadow:
      0 18px 35px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .development-card h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: 0.05em;
  }

  .development-card p {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.7;
  }

  .development-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .development-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  :root {
    background: black;
  }
</style>
