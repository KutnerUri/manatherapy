---
import Layout from "../layouts/Layout.astro";
import ScrollHint from "../components/ScrollHint.astro";
import Slide from "../components/Slide.astro";
import Slideshow from "../components/Slideshow.astro";
import metalLogo from "../assets/logos/metal.webp";
import ManaSlide from "../components/ManaSlide.astro";
import SlideInner from "../components/SlideInner.astro";
import SectionTitle from "../components/SectionTitle.astro";

const title = "כבוד — מאנה תרפיה";
const description = "Black mana - honor, pragmatism, and survival.";
---

<Layout title={title} description={description} lang="he" class="theme-black">
  <Slideshow class="deck-black">
    <ManaSlide
      colorClass="black"
      logo={metalLogo}
      logoAlt="Black mana logo"
      sub="כבוד"
      subtitle="סיפוק צרכים"
      slide={0}
    >
      <ScrollHint />
    </ManaSlide>

    <Slide class="text-slide slide-black-intro" slide={1}>
      <SlideInner>
        <SectionTitle>כבוד הוא הכוח לדאוג לעצמנו.</SectionTitle>
        <div class="body">
          <p>הוא שואל:</p>
          <p>מה אנחנו רוצים,</p>
          <p>ואיך משיגים את זה</p>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-black-worldview" slide={2}>
      <SlideInner>
        <SectionTitle>תפיסת עולם</SectionTitle>
        <div class="body">
          <p>כבוד מניח שהעולם קשה,</p>
          <p>שהמשאבים מוגבלים,</p>
          <p>ושאף אחד לא יבוא להציל אותך.</p>
        </div>
        <div class="body">
          <p>מתוך ההנחה הזו, כבוד מעריך:</p>
          <p>תועלת עצמית,</p>
          <p>אמביציה,</p>
          <p>והתמודדות עם אמיתות לא נעימות.</p>
        </div>
        <div class="body">
          <p>כבוד לא מתחבא מאחורי כוונות טובות, דיונים תאורטיים, ותיורצים.</p>
          <p>הוא אומר: אם אתה רוצה משהו - אתה משלם.</p>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-black-why" slide={3}>
      <SlideInner>
        <SectionTitle>למה צריך כבוד</SectionTitle>
        <div class="body">
          <p>כבוד נותן לנו אנכיות -</p>
          <p>נקודת מבט סובייקטיבית שממנה ניתן לקבל החלטות, גם אם הן קשות.</p>
          <p>בלעדיו - אין עצמי. כל דבר הופך להיות מרוחק ותאורטי</p>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-black-allows" slide={4}>
      <SlideInner>
        <SectionTitle>מה כבוד מאפשר לנו</SectionTitle>
        <div class="body">
          <p>לבחור.</p>
          <p>להציב גבולות.</p>
          <p>לשאת מחירים.</p>
          <p>ולהשיג מה שאנחנו רוצים.</p>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-black-creation" slide={5}>
      <SlideInner>
        <SectionTitle>יצירה של מאנה שחורה</SectionTitle>
        <div class="creation-grid">
          <article class="creation-card">
            <h3>בדיקת רצון</h3>
            <p>בכל פעם שיש ספק, לשאול - מה אני רוצה?</p>
          </article>
          <article class="creation-card">
            <h3>הערכה לרצון</h3>
            <p>אם אני רוצה את זה, זה חשוב</p>
          </article>
          <article class="creation-card">
            <h3>מודעות למחיר</h3>
            <p>מה המחיר המלא למה שאני רוצה? האם אני מוכן לשלם אותו?</p>
          </article>
          <article class="creation-card">
            <h3>הערכה לסיפוק</h3>
            <p>האם אני מרוצה ממה שקיבלתי?</p>
          </article>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-black-development" slide={6}>
      <SlideInner>
        <SectionTitle>התפתחות</SectionTitle>
        <div class="development-grid">
          <article class="development-card">
            <h3>כבוד ילדותי</h3>
            <p>
              כבוד לא מפותח ממהר לספק צרכים, אך נוטה להתעלם מהמחיר ומההשפעה שלו
              על אחרים והעתיד.
            </p>
            <p>
              הוא מבלבל בין סיפוק מיידי וסיפוק אמיתי, מתקשה להציב גבולות ברורים,
              וכשדברים משתבשים הוא חוזר וחוזר וחוזר לתחושת קורבנות.
            </p>
          </article>
          <article class="development-card">
            <h3>כבוד בוגר</h3>
            <p>כבוד בוגר מכיר בצרכים ומספק אותם במידה הנכונה.</p>
            <p>
              הוא מסוגל לדחות סיפוק או לתת לרצון להתפוגג, מקבל החלטות מתוך חישוב
              עלות־תועלת בריא, מציב גבולות שקטים וברורים, ולוקח אחריות מלאה על
              התוצאות.
            </p>
          </article>
        </div>
      </SlideInner>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .theme-black {
    --color-text: #f1efe6;
    --color-surface: #120012;
    --color-surface-alt: #1a0d24;
    --color-overlay-light: rgba(255, 255, 255, 0.08);
    --color-overlay-dark: rgba(0, 0, 0, 0.5);
    --color-invert: #f1efe6;
    color: var(--color-text);
    background: radial-gradient(circle at top, #1b0a24, #0c0612);
  }

  .slide-black-intro {
    background:
      radial-gradient(
        circle at 20% 25%,
        rgba(120, 60, 160, 0.18),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(30, 10, 40, 0.7),
        transparent 60%
      ),
      linear-gradient(150deg, #2a0c3a 0%, #120012 65%, #080008 100%);
  }

  .slide-black-worldview {
    background:
      radial-gradient(
        circle at 25% 20%,
        rgba(70, 20, 100, 0.35),
        transparent 55%
      ),
      radial-gradient(
        circle at 70% 80%,
        rgba(0, 0, 0, 0.7),
        transparent 60%
      ),
      linear-gradient(150deg, #1f0b2c 0%, #0f0716 60%, #07040b 100%);
  }

  .slide-black-why {
    background:
      radial-gradient(
        circle at 15% 30%,
        rgba(120, 60, 160, 0.25),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(0, 0, 0, 0.65),
        transparent 60%
      ),
      linear-gradient(150deg, #240b34 0%, #120012 60%, #07040b 100%);
  }

  .slide-black-worldview .body p,
  .slide-black-intro .body p,
  .slide-black-why .body p,
  .slide-black-allows .body p {
    font-size: clamp(1.15rem, 2.6vw, 1.9rem);
    line-height: 1.7;
  }

  .slide-black-why .section-title {
    color: #f4efe4;
  }

  .slide-black-allows {
    background:
      radial-gradient(
        circle at 20% 30%,
        rgba(90, 50, 130, 0.28),
        transparent 55%
      ),
      radial-gradient(
        circle at 75% 75%,
        rgba(0, 0, 0, 0.6),
        transparent 60%
      ),
      linear-gradient(150deg, #240b34 0%, #0f0617 60%, #06030a 100%);
  }

  .slide-black-creation {
    background:
      radial-gradient(
        circle at 18% 20%,
        rgba(140, 70, 190, 0.22),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(0, 0, 0, 0.65),
        transparent 60%
      ),
      linear-gradient(150deg, #1e0a2a 0%, #0d0613 60%, #05020a 100%);
  }

  .slide-black-development {
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(120, 80, 170, 0.2),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 75%,
        rgba(0, 0, 0, 0.65),
        transparent 60%
      ),
      linear-gradient(150deg, #1b0a28 0%, #0d0614 60%, #05020a 100%);
  }

  .creation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
    margin-top: 1.5rem;
  }

  .creation-card {
    padding: clamp(1.2rem, 2.6vw, 2rem);
    border-radius: 18px;
    background: rgba(10, 6, 16, 0.55);
    box-shadow:
      0 18px 35px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .creation-card h3 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    letter-spacing: 0.05em;
  }

  .creation-card p {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .creation-grid {
      grid-template-columns: 1fr;
    }
  }

  .development-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: 1.5rem;
  }

  .development-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 20px;
    background: rgba(10, 6, 16, 0.55);
    box-shadow:
      0 18px 35px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .development-card h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: 0.05em;
  }

  .development-card p {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.7;
  }

  .development-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .development-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  :root {
    background: black;
  }
</style>
