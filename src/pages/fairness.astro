---
import LineFade from "../components/LineFade.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import Manacard from "../components/Manacard.astro";
import Layout from "../layouts/Layout.astro";
import sunLogo from "../assets/logos/sun.webp";

const title = "סימטריה — מאנה תרפיה";
const description = "White mana - symmetry, shared order, and service to the whole.";
---

<Layout title={title} description={description} lang="he" data-accent="earth">
  <Slideshow>
    <ManaSlide
      colorClass="earth"
      logo={sunLogo}
      logoAlt="Earth mana logo"
      sub="סימטריה"
      subtitle="שירות הכלל"
      slide={0}
    >
      <ScrollHint />
    </ManaSlide>

    <Slide class="text-slide slide-earth" slide={1}>
      <SlideInner>
        <SectionTitle>מהות</SectionTitle>
        <LineFade
          lines={[
            "סימטריה היא הכוח",
            "לראות הכל בתוך אותה מסגרת.",
            "",
            "היא מאפשרת לך ליצור שלווה וביטחון.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-earth" slide={2}>
      <SlideInner>
        <SectionTitle>ראיית עולם</SectionTitle>
        <LineFade
          lines={[
            "בעולם הזה יש סדר.",
            "כיוון לדברים.",
            "אם נשמור עליו -",
            "יהיה מספיק שפע לכולם.",
            "",
            "אם דבר אחד אינו במקומו -",
            "שום דבר לא במקומו.",
            "אם מישהו רעב,",
            "זה רק כי מישהו רימה.",
            "",
            "כמו שהארץ מקיפה את השמש,",
            "כך גם אתה כפוף לחוקי היקום וחוקי האדם.",
            "",
            "תאמין בסדר,",
            "או צור אותו בעצמך.",
            "זו הדרך היחידה",
            "להביא שלווה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-earth" slide={3}>
      <SlideInner>
        <SectionTitle>הוגנות - שורש מוסרי</SectionTitle>
        <LineFade
          lines={[
            "אם היית מקים היום חברה מאפס",
            "מבלי לדעת מי תהיה בתוכה,",
            "חזק או חלש, עשיר או עני,",
            "איזו חברה היית בונה?",
            "",
            "האם היית מצטרף אליה",
            "גם אם היית בתחתית?",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="slide-earth" slide={4}>
      <SectionTitle>מהלכים</SectionTitle>
      <div class="spell-card-row">
        <SpellCard
          title="כלל"
          manas={["1", "1", "1"]}
          lines={["קבע עיקרון שחל על כולם (כולל עצמך)."]}
          quote="לקבוע כלל זה קל, לאכוף פחות"
        />
        <SpellCard
          title="סטנדרט"
          manas={["1"]}
          lines={["קבע תקן על מנת להבטיח אחידות."]}
          quote="אי אפשר להשוות תפוחים לתפוזים"
        />
        <SpellCard
          title="חוזה"
          manas={["1", "1"]}
          lines={["קבע והסכם מראש מה עושים לפני שדברים קורים."]}
        />
        <SpellCard
          title="גירוש"
          manas={["1"]}
          lines={["הרחק דבר שלא נראה נכון."]}
          quote="מה שמפר את השלום - יוגלה את השכחה"
        />
      </div>
    </Slide>

    <Slide class="slide-earth" slide={5}>
      <SectionTitle>איך משיגים אנרגיית סימטריה?</SectionTitle>
      <div class="spell-card-row">
        <Manacard
          title="טקס"
          showMana={false}
          lines={["חזור על אותם הדברים בזמנים קבועים."]}
          quote="כל פעם מחדש אני ..."
        />
        <Manacard
          title="הצהרת כוונות"
          showMana={false}
          lines={["כתוב את מה שחשוב במקום שכולם יראו."]}
        />
        <Manacard
          title="מיון"
          showMana={false}
          lines={["סדר וחלק את הכלים בבית."]}
        />
      </div>
    </Slide>

    <Slide class="text-slide slide-earth" slide={6}>
      <SlideInner>
        <SectionTitle>התפתחות</SectionTitle>
        <div class="development-grid">
          <article class="development-card">
            <h3>סימטריה בלתי מפותחת</h3>
            <p>מאמינה שיש תשובה נכונה אחת לכל שאלה.</p>
            <p>מיישמת כללים בלי לשאול למה.</p>
            <p>לא מסוגלת להתמודד עם יוצאים מן הכלל.</p>
            <p>כשהמציאות לא מתאימה לכלל - היא מתעלמת מהמציאות.</p>
            <p>משתמשת בסדר כתירוץ לא לחשוב.</p>
          </article>
          <article class="development-card">
            <h3>סימטריה בוגרת</h3>
            <p>מבינה שסדר הוא כלי, לא מטרה.</p>
            <p>כלל טוב הוא כלל שאפשר לעמוד בו.</p>
            <p>רואה את האנשים שמולה, ואיך היא משפיעה עליהם.</p>
            <p>פועלת לפי רוח החוק, ולא הטקסט שלו.</p>
          </article>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-earth" slide={7}>
      <SlideInner>
        <!-- <SectionTitle>סיכום</SectionTitle> -->
        <LineFade
          lines={[
            "כמה דברים בחיים שלך",
            "פשוט לא במקום",
            "רק כי אין להם מסגרת?",
            "",
            "סימטריה מראה לך מה הכללים.",
            "אתה רק צריך לעמוד בהם.",
          ]}
        />
      </SlideInner>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .slide-earth {
    background: var(--color-wallpaper) !important;
  }

  .spell-card-row {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
    max-width: 95%;
  }

  @media (max-width: 1100px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .development-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: 1.5rem;
  }

  .development-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 20px;
    background: var(--color-accent-surface);
    box-shadow:
      0 18px 35px var(--fx-shadow-dense),
      inset 0 0 0 1px var(--fx-border-subtle);
  }

  .development-card h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: 0.05em;
  }

  .development-card p {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.7;
  }

  .development-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .development-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
