---
import LineFade from "../components/LineFade.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import Manacard from "../components/Manacard.astro";
import CardRow from "../components/CardRow.astro";
import Layout from "../layouts/Layout.astro";
import plantLogo from "../assets/logos/plant.webp";

const title = "הגרף — מאנה תרפיה";
const description = "Green mana - graph, respect, and complex living systems.";

const graphMoves = [
  {
    title: "לשאת פרי",
    manas: ["1"],
    lines: ["התבגר בנישה שלך, וצור שפע.", "קבל +3 מאנה."],
  },
  {
    title: "לצמוח",
    manas: ["1"],
    lines: [
      "התחזק, גדל או השתפר במיומנות, להתעצם בתחום אחד בחייך.",
      "לא ניתן לגדול מעבר לפוטנציאל הטבעי שלך.",
    ],
  },
  {
    title: "עימות",
    manas: ["1", "1", "1"],
    lines: [
      "אלץ יריב או רעיון להוכיח את עצמו במציאות, ללא יתרונות שקריים או אשליות.",
    ],
  },
  {
    title: "עקירה",
    manas: ["1", "1"],
    lines: ["סלק אלמנט שלא מתאים לסביבה שלך"],
  },
  {
    title: "תמיכת הרשת",
    manas: ["1", "1"],
    lines: [
      "גייס את המערכת לכל מטרה.",
      "מאחר שאתה חלק מרכזי בגרף - הסביבה, המשפחה, או השותפים מתייצבים לעזור כמעט אינסטינקטיבית.",
    ],
  },
  {
    title: "אינסטינקט",
    manas: ["1"],
    lines: [
      "תחושת בטן והבנה אינטואיטבית אומרים לך מה הדבר הנכון לעשות.",
      "״הגוף יודע את התשובה לפני שהשכל בכלל מבין״",
    ],
  },
];

const statuses = [
  {
    title: "חיוניות",
    manas: ["x", "x"],
    lines: [
      "הכפל קצב החלמה, קבל יציבות, וקבל סיבולת להתמודד עם התשה ורעלים.",
    ],
  },
  {
    title: "חסינות",
    manas: ["1", "1"],
    lines: [
      "הגן על עצמך ממניפולציה, ושאר רעלים.",
      "ציפיות עלבונות, או תחושת ״לא מספיק״ חסרי השפעה.",
    ],
  },
  {
    title: "שבריריות הפוכה",
    manas: ["1", "1", "1"],
    lines: [
      "במקום להישבר ממכה קשה, גדל סביבה ״מה שלא הורג אותך, מחשל אותך״",
    ],
  },
];

const manaSources = [
  {
    title: "מגע עם החיים",
    lines: [
      "שמור קשר עם הטבע.",
      "חשיפה לשמש, תזונה, שינה, טיפול בצמחים או בעלי חיים ושהייה בטבע.",
    ],
  },
  {
    title: "מצא את מקומך",
    lines: ["העבר את הזמן במקום שאתה משגשג"],
  },
  {
    title: "חקר שורשים",
    lines: [
      "למד את המסורת, המהות, ואיך דברים מתפתחים באופן טבעי.",
      "״מביצה של עורב לא תבקע יונה״",
    ],
  },
  {
    title: "התמדה ואימון",
    lines: ["עשה את הדבר שלך, גם כשזה קשה, לאורך זמן"],
  },
  {
    title: "סימביוזה",
    lines: ["מצא שיתוף פעולה וחיבור"],
  },
  {
    title: "הגנה על הרשת",
    lines: ["עמידה לצד אלו שתלויים בך, וחיזוק הצמחתים שמזינים אותך"],
  },
];
---

<Layout title={title} description={description} lang="he" data-accent="plant">
  <Slideshow>
    <ManaSlide
      colorClass="plant"
      logo={plantLogo}
      logoAlt="Green mana logo"
      sub="הגרף"
      subtitle="כבוד"
      slide={0}
    >
      <ScrollHint />
    </ManaSlide>

    <Slide class="text-slide slide-plant" slide={1}>
      <SlideInner>
        <SectionTitle>מהות</SectionTitle>
        <LineFade
          lines={[
            "הגרף הוא השלם",
            "הגדול מסכום חלקיו.",
            "זהו הכוח שמגיח ממערכות מורכבות.",
            "",
            "בעזרתו,",
            "אני מוצא את מקומי",
            "ויוצר שפע.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-plant" slide={2}>
      <SlideInner>
        <SectionTitle>השקפת עולם</SectionTitle>
        <LineFade
          lines={[
            "כל הדברים בעולם מחוברים ברשת בלתי נראית של חיים.",
            "המשפחה, החברה, הטבע, השמש והכוכבים.",
            "פרפר המנפנף את כנפיו גורם לרעידות בצד השני של העולם.",
            "כל דבר שקיים יודע זאת בפנים, ושואף למצוא את מקומו -",
            "איפה שהוא חיוני, ומשגשג בהרמוניה.",
            "",
            "כשדוחקים יצור ושהוא אינו מוצא חיבור, הוא זועם,",
            "מנסה לשבור את המבנה, כדי למצוא מקום.",
            "",
            "העולם הוא משחק סכום חיובי,",
            "העושר של האחר הוא העושר שלך.",
            "להשתלב משמעו לשגשג יחד.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-plant" slide={3}>
      <SlideInner>
        <SectionTitle>שורש מוסרי - כבוד</SectionTitle>
        <LineFade
          lines={[
            "כבוד הוא ההכרה במורכבות ובריאות הגרף.",
            "החיבורים שבתוך חברה, בין אנשים, בתוך אנשים.",
            "אדם אינו רק צומת בודד בגרף, הוא גם כל החיבורים שלו לשכניו.",
            "",
            "כל אדם זכאי לכבוד מינימלי,",
            "הרבה יותר מכל בעל חיים אחר,",
            "בזכות ההשפעה העצומה שלו על כל הכוכב.",
            "",
            "עם זאת, על האדם להתעלות ולהוכיח את עצמו.",
            "לייצר שינוי לטובה ושפע בעולם סביבו,",
            "לכבד את עצמו, קדמוניו, וסביבתו.",
            "",
            "כבוד אינו מחמאה,",
            "הוא מדידה מדויקת של משקל אמיתי בתוך הגרף.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-plant" slide={4}>
      <SlideInner>
        <SectionTitle>כבוד שברירי</SectionTitle>
        <LineFade
          lines={[
            "כדי לגדול ולהתחזק,",
            "לפעמים הגרף חייב להיפרם.",
            "יש להניח לישן לגווע,",
            "כדי לפנות מקום לחדש וחזק יותר.",
            "",
            "המוות הוא חלק מן המעגל;",
            "מי שלא מקבל אותו,",
            "סופו לשקוע ביחד איתו.",
            "",
            "ומאחר שכל מבנה יום אחד יתפרק,",
            "ניצבת דילמה בפני כל דבר חי:",
            "האם להתמסר, ולהתמחות בנישה,",
            "או להתנתק מחבל הטבור ולצמוח כישות נפרדת.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="slide-plant" slide={5}>
      <SectionTitle>מהלכי גרף</SectionTitle>
      <CardRow>
        {
          graphMoves.slice(0, 4).map((move) => (
            <SpellCard
              accent="plant"
              title={move.title}
              manas={move.manas}
              lines={move.lines}
            />
          ))
        }
      </CardRow>
    </Slide>

    <Slide class="slide-plant" slide={6}>
      <CardRow>
        {
          graphMoves.slice(4).map((move) => (
            <SpellCard
              accent="plant"
              title={move.title}
              manas={move.manas}
              lines={move.lines}
            />
          ))
        }
      </CardRow>
    </Slide>

    <Slide class="slide-plant" slide={7}>
      <SectionTitle>סטטוטים:</SectionTitle>
      <CardRow>
        {
          statuses.map((status) => (
            <SpellCard
              accent="plant"
              title={status.title}
              manas={status.manas}
              lines={status.lines}
            />
          ))
        }
      </CardRow>
    </Slide>

    <Slide class="slide-plant" slide={8}>
      <SectionTitle>מקורות מאנה</SectionTitle>
      <CardRow>
        {
          manaSources.slice(0, 4).map((source) => (
            <Manacard
              accent="plant"
              title={source.title}
              showMana={false}
              lines={source.lines}
            />
          ))
        }
      </CardRow>
    </Slide>

    <Slide class="slide-plant" slide={9}>
      <CardRow>
        {
          manaSources.slice(3).map((source) => (
            <Manacard
              accent="plant"
              title={source.title}
              showMana={false}
              lines={source.lines}
            />
          ))
        }
      </CardRow>
    </Slide>

    <Slide class="text-slide slide-plant" slide={10}>
      <SlideInner>
        <SectionTitle>התפתחות</SectionTitle>
        <div class="development-grid">
          <article class="development-card">
            <h3>גרף בלתי בוגר</h3>
            <p>אגוצנטרי ולא מכיר את מקומו - ולכן עיוור למקומם של אחרים.</p>
            <p>יהיר וכועס, דורש כבוד ומשאבים מבלי לייצר ערך.</p>
          </article>
          <article class="development-card">
            <h3>גרף בוגר</h3>
            <p>בטוח בעצמו, מכבד את עצמו ואחרים.</p>
            <p>יודע את מקומו ומחזיק בו בביטחון.</p>
            <p>הפירות שלו גדלים בחיבורים שהוא יוצר —</p>
            <p>מתוך הרשת, לא רק מכוח אישי.</p>
            <p>בלתי ניתן להחלפה לא על ידי כוח,</p>
            <p>אלא על ידי צמיחה.</p>
          </article>
        </div>
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-plant" slide={11}>
      <SlideInner>
        <SectionTitle>הזמנה</SectionTitle>
        <LineFade
          lines={[
            "אתה חלק מגרף בלתי נגמר של חיים,",
            "עם פוטנציאל בלתי נגמר לשפע.",
            "",
            "כל שאתה צריך לעשות הוא",
            "למצוא את מקומך ולהתחבר.",
            "קבל את עובדות החיים.",
            "",
            "מצא את השותפים שלך",
            "או שטפילים ימצאו אותך.",
          ]}
        />
      </SlideInner>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .slide-plant {
    background: var(--color-wallpaper) !important;
  }

  .development-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: 1.5rem;
  }

  .development-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 20px;
    background: var(--color-accent-surface);
    box-shadow:
      0 18px 35px var(--fx-shadow-dense),
      inset 0 0 0 1px var(--fx-border-subtle);
  }

  .development-card h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: 0.05em;
  }

  .development-card p {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.7;
  }

  .development-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .development-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
