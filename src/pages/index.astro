---
import Layout from "../layouts/Layout.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import LineFade from "../components/LineFade.astro";
import PentagonMana from "../components/PentagonMana.astro";
import SectionTitle from "../components/SectionTitle.astro";
import bakingCakeImage from "../assets/baking-cake.jpg";
import bakingImage from "../assets/baking.jpg";
import drivingImage from "../assets/driving.jpg";
import elemMagicImage from "../assets/elem-magic.webp";
import elemWideImage from "../assets/elem-wide.webp";
import fireLogo from "../assets/logos/fire.webp";
import metalLogo from "../assets/logos/metal.webp";
import plantLogo from "../assets/logos/plant.webp";
import recipeImage from "../assets/recipe.jpg";
import sunLogo from "../assets/logos/sun.webp";
import water from "../assets/logos/water.webp";
---

<Layout
  title="Manatherapy"
  description="Mana theory - the resources of life, the five types of resources, and doing magic in daily life."
>
  <Slideshow>
    <Slide
      class="slide-hero"
      slide={0}
      style={`--hero-image: url(${elemMagicImage.src}); --hero-image-wide: url(${elemWideImage.src})`}
    >
      <h1 class="title">מאנה תרפיה</h1>
      <ScrollHint />
    </Slide>

    <Slide class="text-slide slide-intro" slide={1}>
      <SlideInner>
        <SectionTitle>מאנה תרפיה</SectionTitle>
        <LineFade
          lines={[
            "מאנה תרפיה היא תורה שמסבירה מדוע דברים אינם קורים",
            "מה צריך כדי לגרום לדברים לקרות",
            "ואיך להשיג את זה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-spell" slide={2}>
      <SlideInner>
        <LineFade
          lines={[
            "בחיי היום-יום שלנו אנחנו מטילים כשפים.",
            "אני קורא להם כשפים שכן הם לא פחות מקסם.",
            "עם מספיק אנרגיה אנחנו יכולים להזיז הרים.",
            "להדליק אש",
            "ולשנות את חיינו.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-spell" slide={3}>
      <SlideInner>
        <LineFade
          lines={[
            "מה שרבים אינם מבינים הוא",
            "לא רק שכל כישוף דורש מחיר,",
            "שהמחיר הוא משאבים שחייבים להתאים לדרישות הכישוף.",
            "למשאבים האלה אני קורא מאנה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-colors" slide={4}>
      <SlideInner>
        <SectionTitle>חמישה ערכי יסוד</SectionTitle>
        <LineFade
          lines={[
            "מאנה מגיעה מחמישה מקורות.",
            "כל אחד משאב אחר,",
            "כדי לשגשג,",
            "צריך את כולם.",
          ]}
        />
      </SlideInner>
    </Slide>

    <ManaSlide
      slide={5}
      colorClass="water"
      logo={water}
      logoAlt="Blue mana logo"
      sub="תודעה"
      subtitle="השלמת ידע"
    />

    <ManaSlide
      slide={6}
      colorClass="plant"
      logo={plantLogo}
      logoAlt="Green mana logo"
      sub="קבוצה"
      subtitle="צמיחת זהויות"
    />

    <ManaSlide
      slide={7}
      colorClass="fire"
      logo={fireLogo}
      logoAlt="Red mana logo"
      sub="חיוּת"
      subtitle="מימוש דחפים"
    />

    <ManaSlide
      slide={8}
      colorClass="earth"
      logo={sunLogo}
      logoAlt="Yellow mana logo"
      sub="סימטריה"
      subtitle="שירות הכלל"
    />

    <ManaSlide
      slide={9}
      colorClass="metal"
      logo={metalLogo}
      logoAlt="Black mana logo"
      sub="אגד"
      subtitle="בחירת תוצאות"
    />

    <Slide class="slide-finale" slide={10}>
      <SectionTitle class="finale-title">למד עוד</SectionTitle>
      <PentagonMana />
      <div class="down-arrow">
        <span class="label">לדוגמאות</span>
        <span class="arrow">↓</span>
      </div>
    </Slide>

    <Slide class="slide-card" slide={11}>
      <SpellCard
        accent="earth"
        title="נהיגה"
        manas={["1"]}
        imageSrc={drivingImage.src}
        imageAlt="Driving spell illustration"
        lines={["שליטה ברכב", "ציות לתמרורים", "השתלבות בתנועה"]}
      />
    </Slide>

    <Slide class="slide-combo" slide={12}>
      <div class="combo-row">
        <div class="card-stack">
          <SpellCard
            accent="earth"
            class="base"
            title="מתכון"
            manas={["1"]}
            imageSrc={recipeImage.src}
            imageAlt="Recipe spell illustration"
            lines={[
              "מסמך שמפרט מרכיבים,",
              "שלבי הכנה מדויקים,",
              "וכמויות ליצירת מאכל מוגמר.",
            ]}
          />
          <SpellCard
            accent="fire"
            class="overlap"
            title="בישול"
            manas={["1", "1"]}
            imageSrc={bakingImage.src}
            imageAlt="Baking spell illustration"
            lines={["עבד מרכיבים", "הכנס לתבנית", "השתמש בתנור"]}
          />
        </div>

        <div class="combo-equals">=</div>
        <SpellCard
          class="mix-card"
          accent="earth"
          title="אפיית עוגה"
          manas={[
            { value: "1", accent: "earth", label: "Earth mana" },
            { value: "1", accent: "fire", label: "Fire mana" },
            { value: "1", accent: "fire", label: "Fire mana" },
          ]}
          imageSrc={bakingCakeImage.src}
          imageAlt="Bake a cake spell illustration"
          lines={["צור עוגה טעימה", "ומוכנה להגשה"]}
        />
      </div>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .title {
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-top: 1.62em;
    font-size: 5vmax;
    text-align: center;
    text-shadow:
      0 2px 10px var(--fx-light-glow-strong),
      0 0 22px var(--fx-light-glow);
  }

  .slide-hero {
    background-color: var(--color-wallpaper);
    background-image: var(--hero-image);
    background-repeat: no-repeat;
    background-position: center 23%;
    background-size: cover;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (orientation: landscape) {
    .slide-hero {
      background-image: var(--hero-image-wide);
    }
  }

  .slide-finale {
    background:
      radial-gradient(circle at 50% 14%, var(--token-fire-wallpaper)),
      radial-gradient(circle at 18% 33%, var(--token-plant-wallpaper)),
      radial-gradient(circle at 82% 33%, var(--token-earth-wallpaper)),
      radial-gradient(circle at 25% 78%, var(--token-water-wallpaper)),
      radial-gradient(circle at 75% 78%, var(--token-metal-wallpaper)),
      var(--color-bg-gradient);
  }
  .finale-title {
    margin: 0;
  }

  .down-arrow {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    font-size: clamp(1.1rem, 2.6vw, 1.6rem);
    letter-spacing: 0.08em;
  }

  .down-arrow .arrow {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .combo-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .base {
    transform: rotate(-4deg);
  }

  [dir="rtl"] .base {
    transform: rotate(4deg);
  }

  .overlap {
    margin-inline-start: -8em;
    margin-top: 2em;
    transform: rotate(4deg);
  }

  [dir="rtl"] .overlap {
    transform: rotate(-4deg);
  }

  .spellcard-template.mix-card {
    --color-accent-surface: linear-gradient(90deg, var(--token-earth-surface) 23%, var(--token-fire-surface));
  }

  .card-stack {
    display: flex;
    place-content: center;
  }

  .combo-equals {
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--fx-shadow-full);
    margin: 0 clamp(1.5rem, 3vw, 3rem);
  }

  @media (max-width: 720px) {
    .combo-row {
      width: 100%;
      height: 100%;
      overflow: hidden;
      gap: 10px;
      flex-direction: column;
    }

    .down-arrow {
      width: min(15vh, 200px);
    }
  }
</style>
