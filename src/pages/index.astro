---
import Layout from "../layouts/Layout.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import LineFade from "../components/LineFade.astro";
import PentagonMana from "../components/PentagonMana.astro";
import SectionTitle from "../components/SectionTitle.astro";
import bakingCakeImage from "../assets/baking-cake.jpg";
import bakingImage from "../assets/baking.jpg";
import drivingImage from "../assets/driving.jpg";
import elemMagicImage from "../assets/elem-magic.webp";
import elemWideImage from "../assets/elem-wide.webp";
import fireLogo from "../assets/logos/fire.webp";
import metalLogo from "../assets/logos/metal.webp";
import plantLogo from "../assets/logos/plant.webp";
import recipeImage from "../assets/recipe.jpg";
import sunLogo from "../assets/logos/sun.webp";
import water from "../assets/logos/water.webp";
---

<Layout
  title="Manatherapy"
  description="Mana theory - the resources of life, the five types of resources, and doing magic in daily life."
>
  <Slideshow>
    <Slide
      class="slide-hero"
      slide={0}
      style={`--hero-image: url(${elemMagicImage.src}); --hero-image-wide: url(${elemWideImage.src})`}
    >
      <h1 class="title">מאנה תרפיה</h1>
      <ScrollHint />
    </Slide>

    <Slide class="text-slide slide-intro" slide={1}>
      <SlideInner>
        <SectionTitle>מאנה תרפיה</SectionTitle>
        <LineFade
          lines={[
            "מאנה תרפיה היא תורה שמסבירה מדוע דברים אינם קורים",
            "מה צריך כדי לגרום לדברים לקרות",
            "ואיך להשיג את זה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-spell" slide={2}>
      <SlideInner>
        <LineFade
          lines={[
            "בחיי היום-יום שלנו אנחנו מטילים כשפים.",
            "אני קורא להם כשפים שכן הם לא פחות מקסם.",
            "עם מספיק אנרגיה אנחנו יכולים להזיז הרים.",
            "להדליק אש",
            "ולשנות את חיינו.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-spell" slide={3}>
      <SlideInner>
        <LineFade
          lines={[
            "מה שרבים אינם מבינים הוא",
            "לא רק שכל כישוף דורש מחיר,",
            "שהמחיר הוא משאבים שחייבים להתאים לדרישות הכישוף.",
            "למשאבים האלה אני קורא מאנה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-colors" slide={4}>
      <SlideInner>
        <SectionTitle>חמישה ערכי יסוד</SectionTitle>
        <LineFade
          lines={[
            "מאנה מגיעה מחמישה מקורות.",
            "כל אחד משאב אחר,",
            "כדי לשגשג,",
            "צריך את כולם.",
          ]}
        />
      </SlideInner>
    </Slide>

    <ManaSlide
      slide={5}
      colorClass="blue"
      logo={water}
      logoAlt="Blue mana logo"
      sub="טוהר"
      subtitle="השלמת ידע"
    />

    <ManaSlide
      slide={6}
      colorClass="green"
      logo={plantLogo}
      logoAlt="Green mana logo"
      sub="נאמנות"
      subtitle="צמיחת זהויות"
    />

    <ManaSlide
      slide={7}
      colorClass="red"
      logo={fireLogo}
      logoAlt="Red mana logo"
      sub="חופש"
      subtitle="מימוש דחפים"
    />

    <ManaSlide
      slide={8}
      colorClass="yellow"
      logo={sunLogo}
      logoAlt="Yellow mana logo"
      sub="הוגנות"
      subtitle="ניהול סיכונים"
    />

    <ManaSlide
      slide={9}
      colorClass="black"
      logo={metalLogo}
      logoAlt="Black mana logo"
      sub="כבוד"
      subtitle="סיפוק צרכים"
    />

    <Slide class="slide-finale" slide={10}>
      <SectionTitle class="finale-title">למד עוד</SectionTitle>
      <PentagonMana />
      <div class="down-arrow">
        <span class="label">לדוגמאות</span>
        <span class="arrow">↓</span>
      </div>
    </Slide>

    <Slide class="slide-card" slide={11}>
      <SpellCard
        color="white"
        title="נהיגה"
        costs={["white"]}
        image={drivingImage}
        imageAlt="Driving spell illustration"
      >
        שליטה ברכב
        <br />
        ציות לתמרורים
        <br />
        השתלבות בתנועה
      </SpellCard>
    </Slide>

    <Slide class="slide-combo" slide={12}>
      <div class="combo-row">
        <div class="card-stack">
          <SpellCard
            color="white"
            class="base"
            title="מתכון"
            costs={["white"]}
            image={recipeImage}
            imageAlt="Recipe spell illustration"
            draggable={false}
          >
            מסמך המפרט את כל המרכיבים הדרושים, שלבי ההכנה המדויקים והכמויות
            הנדרשות ליצירת מאכל מוגמר
          </SpellCard>
          <SpellCard
            color="red"
            class="overlap"
            title="בישול"
            costs={["red", "red"]}
            image={bakingImage}
            imageAlt="Baking spell illustration"
            draggable={false}
          >
            עבד מרכיבים, הכנס לתבנית, השתמש בתנור
          </SpellCard>
        </div>

        <div class="combo-equals">=</div>
        <SpellCard
          class="result"
          title="אפיית עוגה"
          costs={["white", "red", "red"]}
          image={bakingCakeImage}
          imageAlt="Bake a cake spell illustration"
          draggable={false}
        >
          צור עוגה טעימה ומוכנה להגשה
        </SpellCard>
      </div>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .title {
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin-top: 1.62em;
    font-size: 5vmax;
    text-align: center;
    text-shadow:
      0 2px 10px var(--color-glow-strong),
      0 0 22px var(--color-glow);
  }

  .slide-hero {
    background-color: var(--color-bg);
    background-image: var(--hero-image);
    background-repeat: no-repeat;
    background-position: center 23%;
    background-size: cover;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (orientation: landscape) {
    .slide-hero {
      background-image: var(--hero-image-wide);
    }
  }

  .slide-intro {
    background: var(--color-bg-gradient);
  }

  .slide-spell {
    background: var(--color-bg-gradient) !important;
  }

  .slide-colors {
    background: var(--color-bg-gradient) !important;
  }

  .slide-finale {
    background:
      radial-gradient(
        circle at 50% 14%,
        var(--color-fire-shadow),
        transparent 55%
      ),
      radial-gradient(
        circle at 18% 33%,
        var(--color-plant-shadow),
        transparent 55%
      ),
      radial-gradient(
        circle at 82% 33%,
        var(--color-stone-shadow),
        transparent 55%
      ),
      radial-gradient(
        circle at 25% 78%,
        var(--color-water-shadow),
        transparent 60%
      ),
      radial-gradient(
        circle at 75% 78%,
        var(--color-metal-shadow),
        transparent 60%
      ),
      var(--color-bg-gradient) !important;
  }

  .finale-title {
    margin: 0;
  }

  .down-arrow {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    font-size: clamp(1.1rem, 2.6vw, 1.6rem);
    letter-spacing: 0.08em;
  }

  .down-arrow .arrow {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .slide-card {
    background: var(--color-bg-flat) !important;
  }

  .slide-combo {
    background: var(--color-bg-flat) !important;
  }

  .combo-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
  }

  .card-stack {
    display: flex;
    place-content: center;
  }

  .combo-equals {
    font-family: "Gill Sans", "Trebuchet MS", sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-shadow-full);
    margin: 0 clamp(1.5rem, 3vw, 3rem);
  }

  @media (max-width: 720px) {
    .combo-row {
      width: 100%;
      height: 100%;
      overflow: hidden;
      gap: 10px;
      flex-direction: column;
    }

    .down-arrow {
      width: min(15vh, 200px);
    }
  }
</style>
