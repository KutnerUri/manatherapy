---
import LineFade from "../components/LineFade.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import Manacard from "../components/Manacard.astro";
import Layout from "../layouts/Layout.astro";
import waterLogo from "../assets/logos/water.webp";

const title = "טוהר — מאנה תרפיה";
const description = "Blue mana - purity, clarity, and completion of knowledge.";
---

<Layout title={title} description={description} lang="he" data-accent="water">
  <Slideshow>
    <ManaSlide
      colorClass="water"
      logo={waterLogo}
      logoAlt="Blue mana logo"
      sub="טוהר"
      subtitle="השלמת ידע"
      slide={0}
    >
      <ScrollHint />
    </ManaSlide>

    <Slide class="text-slide slide-water" slide={1}>
      <SlideInner>
        <SectionTitle>טוהר הוא הכוח להבין לעומק.</SectionTitle>
        <LineFade
          lines={["הוא שואל:", "מה נכון?", "ומה חסר לי לדעת?"]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-water" slide={2}>
      <SlideInner>
        <SectionTitle>תפיסת עולם</SectionTitle>
        <LineFade
          lines={[
            "טוהר מניח שהמציאות מורכבת,",
            "ושכדי לפעול נכון צריך להבין אותה.",
            "",
            "מתוך ההנחה הזו, טוהר מעריך:",
            "סקרנות,",
            "דיוק,",
            "ולמידה מתמדת.",
            "טוהר לא מסתפק בדעה מהירה; הוא בודק, משווה, ומתקן.",
            "",
            "הוא אומר:",
            "קודם להבין",
            "ואז לפעול",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-water" slide={3}>
      <SlideInner>
        <SectionTitle>למה צריך טוהר</SectionTitle>
        <LineFade
          lines={[
            "טוהר נותן לנו בהירות -",
            "יכולת לזהות דפוסים, להימנע מטעויות, ולקבל החלטות מדויקות.",
            "בלעדיו - אנחנו פועלים מתוך רעש והנחות לא בדוקות.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="slide-water" slide={4}>
      <SectionTitle>מה טוהר מאפשר לנו</SectionTitle>
      <div class="spell-card-row">
        <SpellCard
          title="לחקור"
          manas={["1"]}
          lines={["בחר שאלה אחת, והעמק בה עד הסוף."]}
          quote="סקרנות ממוקדת יוצרת בהירות"
        />
        <SpellCard
          title="לנסח שאלה"
          manas={["1"]}
          lines={["הגדר במדויק מה אתה מנסה להבין."]}
          quote="שאלה טובה חוסכת חצי מהדרך"
        />
        <SpellCard
          title="לתכנן"
          manas={[
            "1",
            { value: "X", accent: "colorless", label: "Colorless mana" },
          ]}
          lines={[
            "בנה תהליך בדיקה מדורג.",
            "הגדר X שלבים לאימות לפני החלטה.",
          ]}
          quote="דיוק הוא תוצר של תהליך"
        />
        <SpellCard
          title="לדייק"
          manas={["1", "1", "1"]}
          lines={[
            "זהה טעות אחת משמעותית.",
            "תקן אותה וחזור על הפעולה נכון יותר.",
          ]}
          quote="שיפור קטן חוזר יוצר קפיצה גדולה"
        />
      </div>
    </Slide>

    <Slide class="slide-water" slide={5}>
      <div class="spell-card-row">
        <SpellCard
          title="להסביר בפשטות"
          manas={["1", "1"]}
          lines={[
            "הפוך רעיון מורכב ל-3 משפטים ברורים.",
            "אם אי אפשר להסביר - צריך ללמוד עוד.",
          ]}
          quote="בהירות נמדדת בפשטות"
        />
        <SpellCard
          title="ריכוז"
          manas={["1"]}
          lines={["כבה הסחות לשעה אחת של חשיבה נקייה."]}
          quote="שקט יוצר עומק"
        />
        <SpellCard
          title="חקר שורש"
          manas={["1"]}
          lines={["זהה את הסיבה האמיתית לבעיה, לא רק סימפטום."]}
          quote="כשטופלים בשורש, התוצאה מחזיקה"
        />
      </div>
    </Slide>

    <Slide class="slide-water" slide={6}>
      <SectionTitle>יצירה של מאנה כחולה</SectionTitle>
      <div class="creation-card-row">
        <Manacard
          title="שאלת הבהרה"
          showMana={false}
          lines={["בכל פעם שיש בלבול:", "מה בדיוק אני מנסה להבין?"]}
        />
        <Manacard
          title="איסוף מידע"
          showMana={false}
          lines={["מה אני כבר יודע?", "ומה עדיין חסר לי?"]}
        />
        <Manacard
          title="ניסוי קטן"
          showMana={false}
          lines={["בודקים בקטן", "לפני החלטה גדולה."]}
        />
        <Manacard
          title="סיכום למידה"
          showMana={false}
          lines={["מה למדתי הפעם,", "ומה אשנה בפעם הבאה?"]}
        />
      </div>
    </Slide>

    <Slide class="text-slide slide-water" slide={7}>
      <SlideInner>
        <SectionTitle>התפתחות</SectionTitle>
        <div class="development-grid">
          <article class="development-card">
            <h3>טוהר ילדותי</h3>
            <p>
              נשאב לידע אינסופי, אך מתקשה לתרגם אותו לפעולה.
            </p>
            <p>
              הוא מחפש ודאות מלאה, מתעכב על פרטים, ופוחד לטעות ולכן נתקע.
            </p>
          </article>
          <article class="development-card">
            <h3>טוהר בוגר</h3>
            <p>לומד כדי לפעול טוב יותר.</p>
            <p>
              הוא מבדיל בין עיקר לטפל, בודק הנחות בצורה שיטתית, ומעדכן החלטות
              לפי עובדות חדשות.
            </p>
          </article>
        </div>
      </SlideInner>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .slide-water {
    background: var(--color-wallpaper) !important;
  }

  .spell-card-row {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
    max-width: 95%;
  }

  @media (max-width: 1100px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .creation-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .creation-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .creation-card-row {
    width: 100%;
    max-width: 95%;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
  }

  .development-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: 1.5rem;
  }

  .development-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 20px;
    background: var(--color-accent-surface);
    box-shadow:
      0 18px 35px var(--fx-shadow-dense),
      inset 0 0 0 1px var(--fx-border-subtle);
  }

  .development-card h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: 0.05em;
  }

  .development-card p {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.7;
  }

  .development-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .development-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
