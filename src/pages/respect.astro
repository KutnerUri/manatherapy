---
import LineFade from "../components/LineFade.astro";
import ManaSlide from "../components/ManaSlide.astro";
import ScrollHint from "../components/ScrollHint.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Slide from "../components/Slide.astro";
import SlideInner from "../components/SlideInner.astro";
import Slideshow from "../components/Slideshow.astro";
import SpellCard from "../components/SpellCard.astro";
import Manacard from "../components/Manacard.astro";
import Layout from "../layouts/Layout.astro";
import gettingWhatYouWantImage from "../assets/metal/getting-what-you-want.webp";
import settingBordersImage from "../assets/metal/setting-borders.webp";
import workDoneImage from "../assets/metal/work-done.webp";
import choosingImage from "../assets/metal/choosing.webp";
import extractionImage from "../assets/metal/extraction.webp";
import loanImage from "../assets/metal/loan.webp";
import thinkingImage from "../assets/metal/thinking.jpg";
import metalLogo from "../assets/logos/metal.webp";

const title = "יחידוּת — מאנה תרפיה";
const description = "Black mana - singularity, pragmatism, and survival.";
---

<Layout title={title} description={description} lang="he" data-accent="metal">
  <Slideshow>
    <ManaSlide
      colorClass="metal"
      logo={metalLogo}
      logoAlt="Black mana logo"
      sub="יחידוּת"
      subtitle="סיפוק צרכים"
      slide={0}
    >
      <ScrollHint />
    </ManaSlide>

    <Slide class="text-slide slide-metal" slide={1}>
      <SlideInner>
        <SectionTitle>מהות</SectionTitle>
        <LineFade
          lines={[
            "היחיד הוא הכוח",
            "להיות אני.",
            "",
            "בעזרתו, אני יודע מה אני רוצה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-metal" slide={2}>
      <SlideInner>
        <SectionTitle>ראיית עולם</SectionTitle>
        <LineFade
          lines={[
            "אני נולדתי לעולם שלא ביקשתי להיכנס אליו.",
            "המשאבים כבר חולקו. הכללים כבר נקבעו.",
            "אף אחד לא ינשום בשבילי,",
            "ואף אחד לא חייב לי כלום.",
            "",
            "אני יודע כמה קל להפסיד.",
            "את הזמן, הגוף, המוניטין, ההזדמנויות.",
            "כולם יכולים להיהרס במילה אחת או בתנועה.",
            "",
            "שום דבר לא בא בחינם.",
            "אני לא מתנצל על כך שאני רוצה.",
            "ביטול עצמי הוא המחיר היקר מכולם.",
            "",
            "אבל הבנה לבד לא מספיקה.",
            "רק מי שאמיץ מספיק לשלם את המחיר, בלי תירוצים -",
            "ראוי לכבוד.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="text-slide slide-metal" slide={3}>
      <SlideInner>
        <SectionTitle>כבוד - שורש מוסרי</SectionTitle>
        <LineFade
          lines={[
            "כל דבר יחיד במהותו,",
            "ללא תחליף,",
            "וסופו בלתי נמנע.",
            "",
            "הזמן זורם רק בכיוון אחד.",
            "מה שאני נותן - לא בהכרח יחזור.",
            "ברגע זה, כאן ועכשיו,",
            "יש לי את הכוח לבנות או להרוס.",
            "",
            "כבוד הוא האחריות לכוח שלי, ולעצמי.",
            "אין דבר ללא מחיר והקרבה.",
          ]}
        />
      </SlideInner>
    </Slide>

    <Slide class="slide-metal" slide={4}>
      <SectionTitle>מה יחידוּת מאפשרת לנו</SectionTitle>
      <div class="spell-card-row">
        <SpellCard
          title="לבחור"
          manas={["1"]}
          imageSrc={choosingImage.src}
          imageAlt="Choosing spell illustration"
          lines={["דלג על דילמה"]}
          quote="זה קל לבחור כשאתה יודע מה אתה רוצה"
        />
        <SpellCard
          title="להציב גבולות"
          manas={["1"]}
          imageSrc={settingBordersImage.src}
          imageAlt="Setting borders spell illustration"
          lines={["סרב לדרישה או ציפייה"]}
          quote="אני לא מוכן, זה יקר מדי"
        />
        <SpellCard
          title="אמביציה"
          manas={[
            "1",
            { value: "X", accent: "colorless", label: "Colorless mana" },
          ]}
          imageSrc={workDoneImage.src}
          imageAlt="Work done spell illustration"
          lines={[
            "התמודד עם אי-נוחות זמנית.",
            "התקדם X צעדים לכיוון היעד שלך.",
          ]}
          quote="אם זה היה קל, כולם היו עושים את זה"
        />
        <SpellCard
          title="להשיג"
          manas={["1", "1", "1"]}
          imageSrc={gettingWhatYouWantImage.src}
          imageAlt="Getting what you want spell illustration"
          lines={[
            "קח דבר מה שאתה רוצה.",
            "במקום לשלם מאנה, ניתן להקריב משהו כתמורה.",
          ]}
          quote="זה מגיע לי"
        />
      </div>
    </Slide>

    <Slide class="slide-metal" slide={5}>
      <div class="spell-card-row">
        <SpellCard
          title="מניפולציה"
          manas={["1", "1"]}
          lines={[
            "השפע על מישהו לטובתך.",
            "שלם עוד 2 מאנה אם אין לו אינטרס.",
            "ועוד 3 אם זה נוגד את האינטרס שלו.",
          ]}
          quote="הוא לא צריך לדעת הכל... כל עוד הוא מרוויח"
        />
        <SpellCard
          title="הלוואה"
          manas={["1"]}
          imageSrc={loanImage.src}
          imageAlt="Loan spell illustration"
          lines={["קבל כסף עכשיו, והחזר פי שתיים בעוד 10 תורות."]}
          quote="העתיד יכול לחכות, אני צריך את זה עכשיו"
        />
        <SpellCard
          title="הפק תועלת"
          manas={["1"]}
          imageSrc={extractionImage.src}
          imageAlt="Extraction spell illustration"
          lines={["קח מצב רע, או משהו שנגמר, ותוציא ממנו ערך."]}
          quote="אם ככה, לפחות אני אצא מזה עם משהו"
        />
      </div>
    </Slide>

    <Slide class="slide-metal" slide={6}>
      <SectionTitle>יצירה של מאנה שחורה</SectionTitle>
      <div class="creation-card-row">
        <Manacard
          title="בדיקת רצון"
          showMana={false}
          imageSrc={thinkingImage.src}
          imageAlt="Thinking illustration"
          lines={["בכל פעם שיש ספק:", "לשאול מה אני רוצה?"]}
          quote="אם אני רוצה את זה, זה חשוב"
        />
        <Manacard
          title="מודעות למחיר"
          showMana={false}
          lines={["מה המחיר המלא?", "האם אני מוכן לשלם אותו?"]}
          quote="...ואני רוצה פרארי"
        />
        <Manacard
          title="הערכה לסיפוק"
          showMana={false}
          lines={["האם אני מרוצה", "ממה שקיבלתי?"]}
        />
      </div>
    </Slide>

    <Slide class="text-slide slide-metal" slide={7}>
      <SlideInner>
        <SectionTitle>התפתחות</SectionTitle>
        <div class="development-grid">
          <article class="development-card">
            <h3>כבוד ילדותי</h3>
            <p>
              ממהר לספק צרכים, אך מתעלם מהמחיר ומההשלכות על אחרים והעתיד.
            </p>
            <p>
              הוא מבלבל בין סיפוק מיידי וסיפוק אמיתי, נותן לאחרים לדרוס אותו,
              וכשדברים משתבשים - חוזר לתחושת קורבנות.
            </p>
          </article>
          <article class="development-card">
            <h3>כבוד בוגר</h3>
            <p>אני לוקח אחריות על צרכי ומעשי.</p>
            <p>
              אני מסוגל לדחות סיפוקים, ולשחרר צרכים שאינם משרתים אותי. מקבל
              החלטות מתוך חישוב תועלת עלות בריא, ומציב גבולות היכן שצריך. אני
              יודע שאיני לבד בעולם. אני מבין מה אני מבקש מאחרים, ומה זה עולה
              להם.
            </p>
          </article>
        </div>
      </SlideInner>
    </Slide>
  </Slideshow>
</Layout>

<style>
  .slide-metal {
    background: var(--color-wallpaper) !important;
  }

  .spell-card-row {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
    max-width: 95%;
  }

  @media (max-width: 1100px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .creation-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .spell-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .creation-card-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .creation-card-row {
    width: 100%;
    max-width: 95%;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-items: center;
  }

  .development-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: 1.5rem;
  }

  .development-card {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 20px;
    background: var(--color-accent-surface);
    box-shadow:
      0 18px 35px var(--fx-shadow-dense),
      inset 0 0 0 1px var(--fx-border-subtle);
  }

  .development-card h3 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    letter-spacing: 0.05em;
  }

  .development-card p {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.7;
  }

  .development-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .development-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
